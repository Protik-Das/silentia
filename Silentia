,"        name = str(col).lower().replace('_', ' ').replace('-', ' ')\n","        if kind == 'estimate':\n","            if re.search(r'estimate|point est|coefficient', name):\n","                return col\n","        elif kind == 'lower':\n","            if re.search(r'lower|lcl|ci low|low ci|lower bound', name):\n","                return col\n","        elif kind == 'upper':\n","            if re.search(r'upper|ucl|ci high|high ci|upper bound', name):\n","                return col\n","    return None\n","\n","results = []\n","\n","xls = pd.ExcelFile(EXCEL_PATH)\n","\n","for sheet in xls.sheet_names:\n","    df = pd.read_excel(EXCEL_PATH, sheet_name=sheet)\n","    df.columns = [str(c).strip() for c in df.columns]\n","\n","    est = find_column(df.columns, 'estimate')\n","    low = find_column(df.columns, 'lower')\n","    high = find_column(df.columns, 'upper')\n","\n","    if est and low and high:\n","        temp = df[[est, low, high]].copy()\n","        temp.columns = ['Estimate', 'Lower', 'Upper']\n","        temp = temp.dropna(how='all')\n","\n","        if len(temp):\n","            temp.insert(0, 'Sheet', sheet)\n","            results.append(temp)\n","\n","if not results:\n","    print(\"Estimate/Lower/Upper columns were not identified.\")\n","    print(\"Available sheets:\", xls.sheet_names)\n","    for sheet in xls.sheet_names:\n","        print(\"\\\\n\", sheet)\n","        print(pd.read_excel(EXCEL_PATH, sheet_name=sheet).columns.tolist())\n","else:\n","    final = pd.concat(results, ignore_index=True).head(8)\n","\n","    print(\"\\\\n========== FIGURE 4: 8 CI RESULTS ==========\")\n","    print(final[['Estimate', 'Lower', 'Upper']].to_string(\n","        index=False,\n","        float_format=lambda x: f'{x:.4f}'\n","    ))\n","\n","    print(\"\\\\n========== COPY THIS TABLE ==========\")\n","    print(final[['Estimate', 'Lower', 'Upper']].to_csv(\n","        index=False,\n","        float_format='%.4f'\n","    ))"],"metadata":{"colab":{"base_uri":"