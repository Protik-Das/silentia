\n","        )\n","        for line in body.split('\\n')\n","    )\n","\n","    heading_lines = heading_wrapped.count('\\n') + 1\n","\n","    # Heading position\n","    heading_y = y + h - (\n","        0.27 if heading_lines == 1 else 0.37\n","    )\n","\n","    ax.text(\n","        x + 0.14, heading_y,\n","        heading_wrapped,\n","        ha='left',\n","        va='center',\n","        fontsize=6.2,\n","        fontweight='bold',\n","        color=BOX_TEXT,\n","        linespacing=1.15,\n","        clip_on=True\n","    )\n","\n","    # Body position\n","    body_y = y + h - (\n","        0.55 if heading_lines == 1 else 0.69\n","    )\n","\n","    ax.text(\n","        x + 0.14, body_y,\n","        body_wrapped,\n","        ha='left',\n","        va='top',\n","        fontsize=5.65,\n","        color=BOX_TEXT,\n","        linespacing=1.28,\n","        clip_on=True\n","    )\n","\n","\n","def arrow(x1, y1, x2, y2):\n","    ax.add_patch(\n","        FancyArrowPatch(\n","            (x1, y1), (x2, y2),\n","            arrowstyle='-|>',\n","            mutation_scale=8,\n","            linewidth=0.8,\n","            color=BOX_EDGE\n","        )\n","    )\n","\n","\n","# TOP ROW: DATA AND MEASUREMENT\n","\n","box(\n","    0.25, 4.35, 3.35, 1.85,\n","    '1 | DATA INPUT',\n","    'World Bank public API\\n'\n","    '131 low- and middle-income economies\\n'\n","    '2000–2024; 11 annual series'\n",")\n","\n","box(\n","    4.32, 4.35, 3.35, 1.85,\n","    '2 | PANEL CONSTRUCTION',\n","    '3,275 country-years\\n'\n","    'Missing values retained as missing\\n'\n","    'No imputation or interpolation'\n",")\n","\n","box(\n","    8.39, 4.35, 3.35, 1.85,\n","    '3 | SILENCE MEASUREMENT',\n","    'M: missing-series share\\n'\n","    'R: repeated observed values\\n'\n","    'G: current gap length; S: composite'\n",")\n","\n","# Top-row arrows\n","arrow(3.65, 5.28, 4.22, 5.28)\n","arrow(7.72, 5.28, 8.29, 5.28)\n","\n","\n","# BOTTOM ROW: THREE ANALYSES\n","\n","box(\n","    0.25, 0.65, 3.35, 2.15,\n","    'A | EARLY-WARNING BENCHMARK',\n","    'Next-year macro-financial stress\\n'\n","    'Logistic regression and gradient boosting\\n'\n","    'Country-held-out validation\\n'\n","    'Rolling-origin validation'\n",")\n","\n","box(\n","    4.32, 0.65, 3.35, 2.15,\n","    'B | GOVERNANCE AND CAPACITY',\n","    'Government effectiveness and SPI\\n'\n","    'Cross-country association\\n'\n","    'Country and year fixed effects\\n'\n","    'Microstate sensitivity analysis'\n",")\n","\n","box(\n","    8.39, 0.65, 3.35, 2.15,\n","    'C | REPORTING COLLAPSES',\n","    'Ten abrupt reporting collapses\\n'\n","    'Five matched controls per episode\\n'\n","    'Difference-in-differences\\n'\n","    'Episode-level bootstrap'\n",")\n","\n","\n","# Shared branching connector\n","ax.plot(\n","    [10.06, 10.06, 1.93, 1.93],\n","    [4.25, 3.55, 3.55, 2.92],\n","    color=BOX_EDGE,\n","    lw=0.8\n",")\n","\n","arrow(1.93, 3.55, 1.93, 2.92)\n","arrow(6.00, 3.55, 6.00, 2.92)\n","arrow(10.06, 3.55, 10.06, 2.92)\n","\n","\n","# Layout\n","fig.subplots_adjust(\n","    left=0.025,\n","    right=0.975,\n","    top=0.98,\n","    bottom=0.03\n",")\n","\n","# Export: TIFF, JPEG and EPS\n","fig.savefig(\n","    f'{OUT}/Figure_1_Study_Design_Fixed.tif',\n","    dpi=DPI,\n","    format='tiff',\n","    pil_kwargs={'compression': 'tiff_lzw'}\n",")\n","\n","fig.savefig(\n","    f'{OUT}/Figure_1_Study_Design_Fixed.jpg',\n","    dpi=DPI,\n","    format='jpeg',\n","    pil_kwargs={'quality': 95}\n",")\n","\n","fig.savefig(\n","    f'{OUT}/Figure_1_Study_Design_Fixed.eps',\n","    format='eps'\n",")\n","\n","plt.show()\n","plt.close(fig)\n","\n","print('Figure 1 fixed and exported successfully.')\n","print('Output folder:', OUT)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":404},"id":"dUyZMbE6pSF2","executionInfo":{"status":"ok","timestamp":1794988395886,"user_tz":-360,"elapsed":6065,"user":{"displayName":"Protik Das","userId":"05892790478659477414