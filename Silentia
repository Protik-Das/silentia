splay_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_2aafc434-64c2-46ae-90c0-78fe905aec8a\", \"silence_global.csv\", 281318)"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_293d2350-a7ca-4a04-97d3-57a849003500\", \"provenance_global.json\", 3526)"]},"metadata":{}}]},{"cell_type":"code","source":["# ===== STEP 3: LACUNA global test (leakage-free, baselines, FE lag test, permutation, episodes) =====\n","import pandas as pd, numpy as np, warnings, os\n","warnings.filterwarnings(\"ignore\")\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.ensemble import HistGradientBoostingClassifier\n","from sklearn.pipeline import make_pipeline\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.impute import SimpleImputer\n","from sklearn.model_selection import GroupKFold\n","from sklearn.metrics import roc_auc_score, average_precision_score, brier_score_loss\n","import statsmodels.api as sm\n","from scipy.stats import fisher_exact\n","rng = np.random.default_rng(42)\n","\n","P, S = \"/content/panel_global_raw_nan.csv\", \"/content/silence_global.csv\"\n","if not os.path.exists(P):\n","    from google.colab import files; files.upload()\n","p = pd.read_csv(P).drop(columns=[\"income\",\"region\"], errors=\"ignore\")\n","s = pd.read_csv(S)[[\"iso\",\"year\",\"M_missing\",\"R_frozen\",\"G_gaprun\",\"S_raw\",\"S_rel\",\"country\",\"income\"]]\n","d = p.merge(s, on=[\"iso\",\"year\"]).sort_values([\"iso\",\"year\"]).reset_index(drop=True)\n","g = d.groupby(\"iso\")\n","d[\"depr\"]  = g.Exchange_rate_LCU_USD.pct_change().mul(100).clip(-50,100)\n","d[\"res_g\"] = g.Reserves_USD.pct_change().mul(100).clip(-80,200)\n","d[\"gdp_g\"] = g.GDP_pc_USD.pct_change().mul(100).clip(-50,50)\n","d[\"infl\"]  = d.Inflation_pct.clip(-10,100)\n","d[\"debt\"]  = d.ExtDebt_pct_GNI.clip(0,300)\n","d[\"S_dm\"]  = d.S_rel - g.S_rel.transform(lambda x: x.expanding().mean().shift(1)).fillna(0)   # within-country, past-only\n","print(\"country-years:\", len(d), \"| countries:\", d.iso.nunique())\n","\n","DEFS = {\"STRICT\": (25,20,-30,None), \"BROAD\": (15,15,-20,-5)}\n","MAC, SIL = [\"infl\",\"depr\",\"res_g\",\"gdp_g\",\"debt\"], [\"S_rel\",\"S_dm\",\"M_missing\",\"G_gaprun\"]\n","def mk_lr(): return make_pipeline(SimpleImputer(strategy=\"median\"), StandardScaler(), LogisticRegression(C=0.5, class_weight=\"balanced\", max_iter=1000))\n","def mk_gb(): return make_pipeline(SimpleImputer(strategy=\"median\"), HistGradientBoostingClassifier(max_depth=3, max_iter=100, learning_rate=0.05, random_state=0))\n","SPECS = {\"persistence\":(None,None), \"macro_LR\":(MAC,mk_lr), \"silence_LR\":(SIL,mk_lr),\n","         \"macro+silence_LR\":(MAC+SIL,mk_lr), \"macro_GBM\":(MAC,mk_gb), \"macro+silence_GBM\":(MAC+SIL,mk_gb)}\n","\n","def twoway(df, cols, iters=15):            # residualise on country + year fixed effects\n","    X = df[cols].copy().astype(float)\n","    for _ in range(iters):\n","        X = X - X.groupby(df.iso.values).transform(\"mean\"); X = X - X.groupby(df.year.values).transform(\"mean\")\n","    return X\n","\n","for DN,(a,b,c,e) in DEFS.items():\n","    D = d.copy(); G = D.groupby(\"iso\")\n","    crash = (D.depr>=a) & (D.depr - G.depr.shift(1) >= 10)\n","    ev = crash | (D.infl>=b) | (D.res_g<=c) | ((D.gdp_g<=e) if e is not None else False)\n","    D[\"event\"] = ev.astype(int); G = D.groupby(\"iso\")\n","    D[\"y_next\"] = G.event.shift(-1); D[\"event_t\"] = D.event\n","    print(\"\\n\" + \"=\"*100 + f\"\\nEVENT DEFINITION {DN}: events={int(D.event.sum())} ({D.event.mean():.1%} of country-years)\")\n","    U = D.dropna(subset=[\"y_next\",\"infl\",\"depr\",\"res_g\",\"gdp_g\"]).reset_index(drop=True); y = U.y_next.astype(int).values\n","    print(\"usable rows:\", len(U), \"| positives:\", y.sum())\n","\n","    def run(splits, label):\n","        out = {k:np.full(len(U), np.nan) for k in SPECS}\n","        for tr, te in splits:\n","            if y[tr].min()==y[tr].max(): continue\n","            for k,(cols,mk) in SPECS.items():\n","                out[k][te] = U.event_t.values[te].astype(float) if cols is None else mk().fit(U.loc[tr,cols], y[tr]).predict_proba(U.loc[te,cols])[:,1]\n","        ok = ~np.isnan(out[\"macro_LR\"]); yy = y[ok]\n","        rows = [[k, roc_auc_score(yy,v[ok]), average_precision_score(yy,v[ok]), brier_score_loss(yy,np.clip(v[ok],0,1))] for k,v in out.items()]\n","        print(f\"\\n{label} (n={ok.sum()}, positives={yy.sum()}, base rate={yy.mean():.3f})\")\n","        print(pd.DataFrame(rows, columns=[\"model\",\"AUC\",\"PR-AUC\",\"Brier\"]).round(3).to_string(index=False))\n","        for A,B in [(\"macro+silence_LR\",\"macro_LR\"),(\"macro+silence_GBM\",\"macro_GBM\")]:\n","            cs = U.iso[ok].unique(); diffs=[]\n","            for _ in range(400):\n","                idx = np.concatenate([np.where((U.iso==c_)&ok)[0] for c_ in rng.choice(cs,len(cs),replace=True)]); yb=y[idx]\n","                if yb.min()!=yb.max(): diffs.append(roc_auc_score(yb,out[A][idx])-roc_auc_score(yb,out[B][idx]))\n","            lo,md,hi = np.percentile(diffs,[2.5,50,97.5])\n","            print(f\"  AUC gain from silence [{A} - {B}]: {md:+.3f}  95% CI [{lo:+.3f},{hi:+.3f}]  {'SIGNIFICANT' if lo>0 or hi<0 else 'CI includes 0'}\")\n","    run(list(GroupKFold(10).split(U, y, U.iso)), \"10-FOLD GROUP-BY-COUNTRY (unseen countries)\")\n","    run([(np.where(U.year<=T)[0], np.where(U.year==T+1)[0]) for T in range(2008,2023)], \"ROLLING-ORIGIN (train<=T, test T+1)\")\n","\n","    print(\"\\nFIXED-EFFECTS LAG TEST (country+year FE, controls, SE clustered by country, + within-country permutation p)\")\n","    for h in [1,2,3]:\n","        T_ = D.copy(); T_[\"yh\"] = T_.groupby(\"iso\").event.shift(-h)\n","        T_ = T_.dropna(subset=[\"yh\",\"S_rel\"]+MAC).reset_index(drop=True)\n","        for sv in [\"S_rel\",\"M_missing\"]:\n","            R = twoway(T_, [\"yh\",sv]+MAC); Z = sm.add_constant(R[[sv]+MAC], has_constant=\"add\")\n","            fit = sm.OLS(R.yh, Z).fit(cov_type=\"cluster\", cov_kwds={\"groups\":T_.iso.astype(\"category\").cat.codes})\n","            obs = fit.params[sv]; perm=[]\n","            for _ in range(200):\n","                Tp = T_.copy(); Tp[sv] = Tp.groupby(\"iso\")[sv].transform(lambda x: rng.permutation(x.values))\n","                Rp = twoway(Tp, [sv]); Zp = pd.concat([Rp[sv], R[MAC]], axis=1).values\n","                perm.append(np.linalg.lstsq(np.c_[np.ones(len(Zp)), Zp], R.yh.values, rcond=None)[0][1])\n","            pp = (np.abs(perm) >= abs(obs)).mean()\n","            print(f\"  h={h} {sv:10s}: coef={obs:+.4f}  clustered p={fit.pvalues[sv]:.3f}  permutation p={pp:.3f}  n={len(T_)}\")\n","\n","    print(\"\\nSILENCE-JUMP EPISODES (M_missing rises >=0.20 in one year) vs stress event in same/next year\")\n","    J = d.copy(); J[\"dM\"] = J.groupby(\"iso\").M_missing.diff(); J[\"jump\"] = (J.dM>=0.20).astype(int)\n","    J = J.merge(D[[\"iso\",\"year\",\"event\"]], on=[\"iso\",\"year\"]); J[\"ev_near\"] = np.maximum(J.event.values, J.groupby(\"iso\").event.shift(-1).fillna(0).values).astype(int)\n","    tab = pd.crosstab(J.jump, J.ev_near); print(tab.to_string())\n","    if tab.shape==(2,2): print(\"  Fisher exact: odds ratio=%.2f p=%.3f\" % fisher_exact(tab.values))\n","    print(\"  jump episodes:\", J[J.jump==1][[\"country\",\"year\"]].sort_values(\"year\").assign(x=lambda t:t.country+\" \"+t.year.astype(str)).x.tolist()[:25])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8sZQsZLfI2gU","executionInfo":{"status":"ok","timestamp":1794139485391,"user_tz":-360,"elapsed":335329,"user":{"displayName":"Protik Das","userId":"05892790478659477414"}},"outputId":"7296947b-2e8c-4469-9768-7858312b2ec6"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["country-years: 3275 | countries: 131\n","\n","====================================================================================================\n","EVENT DEFINITION STRICT: events=327 (10.0% of country-years)\n","usable rows: 2439 | positives: 258\n","\n","10-FOLD GROUP-BY-COUNTRY (unseen countries) (n=2439, positives=258, base rate=0.106)\n","            model   AUC  PR-AUC  Brier\n","      persistence 0.716   0.297  0.107\n","         macro_LR 0.793   0.503  0.157\n","       silence_LR 0.620   0.173  0.237\n"," macro+silence_LR 0.794   0.506  0.155\n","        macro_GBM 0.829   0.498  0.070\n","macro+silence_GBM 0.834   0.505  0.069\n","  AUC gain from silence [macro+silence_LR - macro_LR]: +0.000  95% CI [-0.013,+0.013]  CI includes 0\n","  AUC gain from silence [macro+silence_GBM - macro_GBM]: +0.005  95% CI [-0.006,+0.016]  CI includes 0\n","\n","ROLLING-ORIGIN (train<=T, test T+1) (n=1636, positives=183, base rate=0.112)\n","            model   AUC  PR-AUC  Brier\n","      persistence 0.736   0.344  0.100\n","         macro_LR 0.806   0.552  0.174\n","       silence_LR 0.578   0.193  0.255\n"," macro+silence_LR 0.808   0.552  0.179\n","        macro_GBM 0.824   0.499  0.072\n","macro+silence_GBM 0.824   0.522  0.072\n","  AUC gain from silence [macro+silence_LR - macro_LR]: +0.002  95% CI [-0.017,+0.023]  CI includes 0\n","  AUC gain from silence [macro+silence_GBM - macro_GBM]: -0.000  95% CI [-0.011,+0.010]  CI includes 0\n","\n","FIXED-EFFECTS LAG TEST (country+year FE, controls, SE clustered by country, + within-country permutation p)\n","  h=1 S_rel     : coef=+0.1610  clustered p=0.622  permutation p=0.585  n=2256\n","  h=1 M_missing : coef=+0.0881  clustered p=0.605  permutation p=0.620  n=2256\n","  h=2 S_rel     : coef=-0.2421  clustered p=0.517  permutation p=0.450  n=2158\n","  h=2 M_missing : coef=-0.0349  clustered p=0.852  permutation p=0.865  n=2158\n","  h=3 S_rel     : coef=-0.5892  clustered p=0.134  permutation p=0.060  n=2057\n","  h=3 M_missing : coef=-0.2651  clustered p=0.207  permutation p=0.180  n=2057\n","\n","SILENCE-JUMP EPISODES (M_missing rises >=0.20 in one year) vs stress event in same/next year\n","ev_near     0    1\n","jump              \n","0        2778  487\n","1           7    3\n","  Fisher exact: odds ratio=2.44 p=0.179\n","  jump episodes: ['Eritrea 2012', 'South Sudan 2016', 'Venezuela, RB 2018', 'Yemen, Rep. 2019', 'Afghanistan 2021', 'Sudan 2023', 'Syrian Arab Republic 2023', 'Congo, Dem. Rep. 2024', 'Nicaragua 2024', 'Lebanon 2024']\n","\n","====================================================================================================\n","EVENT DEFINITION BROAD: events=818 (25.0% of country-years)\n","usable rows: 2439 | positives: 647\n","\n","10-FOLD GROUP-BY-COUNTRY (unseen countries) (n=2439, positives=647, base rate=0.265)\n","            model   AUC  PR-AUC  Brier\n","      persistence 0.642   0.363  0.282\n","         macro_LR 0.692   0.532  0.211\n","       silence_LR 0.596   0.341  0.242\n"," macro+silence_LR 0.713   0.542  0.207\n","        macro_GBM 0.712   0.527  0.167\n","macro+silence_GBM 0.765   0.560  0.159\n","  AUC gain from silence [macro+silence_LR - macro_LR]: +0.020  95% CI [+0.002,+0.039]  SIGNIFICANT\n","  AUC gain from silence [macro+silence_GBM - macro_GBM]: +0.052  95% CI [+0.035,+0.068]  SIGNIFICANT\n","\n","ROLLING-ORIGIN (train<=T, test T+1) (n=1636, positives=465, base rate=0.284)\n","            model   AUC  PR-AUC  Brier\n","      persistence 0.633   0.372  0.307\n","         macro_LR 0.669   0.547  0.214\n","       silence_LR 0.527   0.325  0.265\n"," macro+silence_LR 0.662   0.538  0.226\n","        macro_GBM 0.674   0.534  0.181\n","macro+silence_GBM 0.649   0.508  0.189\n","  AUC gain from silence [macro+silence_LR - macro_LR]: -0.008  95% CI [-0.031,+0.014]  CI includes 0\n","  AUC gain from silence [macro+silence_GBM - macro_GBM]: -0.025  95% CI [-0.038,-0.010]  SIGNIFICANT\n","\n","FIXED-EFFECTS LAG TEST (country+year FE, controls, SE clustered by country, + within-country permutation p)\n","  h=1 S_rel     : coef=+0.2171  clustered p=0.598  permutation p=0.580  n=2256\n","  h=1 M_missing : coef=+0.1123  clustered p=0.639  permutation p=0.685  n=2256\n","  h=2 S_rel     : coef=+0.1464  clustered p=0.774  permutation p=0.725  n=2158\n","  h=2 M_missing : coef=+0.1909  clustered p=0.491  permutation p=0.460  n=2158\n","  h=3 S_rel     : coef=+0.4225  clustered p=0.511  permutation p=0.345  n=2057\n","  h=3 M_missing : coef=+0.3983  clustered p=0.247  permutation p=0.100  n=2057\n","\n","SILENCE-JUMP EPISODES (M_missing rises >=0.20 in one year) vs stress event in same/next year\n","ev_near     0     1\n","jump               \n","0        2017  1248\n","1           4     6\n","  Fisher exact: odds ratio=2.42 p=0.196\n","  jump episodes: ['Eritrea 2012', 'South Sudan 2016', 'Venezuela, RB 2018', 'Yemen, Rep. 2019', 'Afghanistan 2021', 'Sudan 2023', 'Syrian Arab Republic 2023', 'Congo, Dem. Rep. 2024', 'Nicaragua 2024', 'Lebanon 2024']\n"]}]},{"cell_type":"code","source":["# ===== STEP 4: is silence a FRAGILITY marker? (governance link) + event study + figures =====\n","import pandas as pd, numpy as np, requests, time, os, warnings\n","warnings.filterwarnings(\"ignore\")\n","import matplotlib; matplotlib.use(\"Agg\"); import matplotlib.pyplot as plt\n","from scipy.stats import spearmanr\n","import statsmodels.api as sm\n","rng = np.random.default_rng(42)\n","P, S = \"/content/panel_global_raw_nan.csv\", \"/content/silence_global.csv\"\n","if not os.path.exists(S):\n","    from google.colab import files; files.upload()\n","sil = pd.read_csv(S); iso_set = set(sil.iso)\n","\n","def get(url, params, tries=3):\n","    for k in range(tries):\n","        try:\n","            r = requests.get(url, params=params, timeout=90); r.raise_for_status(); return r.json()\n","        except Exception: time.sleep(2*(k+1))\n","    return None\n","def wb(names, tries):   # try several (code, source) variants; return long df or None\n","    for code, src in tries:\n","        prm = {\"format\":\"json\",\"per_page\":20000,\"date\":\"2000:2024\"}\n","        if src: prm[\"source\"] = src\n","        js = get(f\"https://api.worldbank.org/v2/country/all/indicator/{code}\", prm)\n","        if js and len(js)>1 and js[1]:\n","            rows = [(r[\"countryiso3code\"], int(r[\"date\"]), r[\"value\"]) for r in js[1] if r[\"countryiso3code\"] in iso_set and r[\"value\"] is not None]\n","            if len(rows) > 200: print(f\"  OK  {names:28s} via {code} (source={src}) rows={len(rows)}\"); return pd.DataFrame(rows, columns=[\"iso\",\"year\",names])\n","    print(f\"  FAIL {names}\"); return None\n","GOV = {\"PolStab\":[(\"PV.EST\",3),(\"GOV_WGI_PV.EST\",None)], \"GovEff\":[(\"GE.EST\",3),(\"GOV_WGI_GE.EST\",None)],\n","       \"RuleLaw\":[(\"RL.EST\",3),(\"GOV_WGI_RL.EST\",None)], \"CtrlCorr\":[(\"CC.EST\",3),(\"GOV_WGI_CC.EST\",None)],\n","       \"SPI\":[(\"IQ.SPI.OVRL\",None),(\"IQ.SPI.OVRL\",3)]}\n","print(\"Downloading governance / statistical-capacity indicators...\")\n","df = sil.copy()\n","for n,t in GOV.items():\n","    x = wb(n, t)\n","    if x is not None: df = df.merge(x, on=[\"iso\",\"year\"], how=\"left\")\n","have = [n for n in GOV if n in df.columns]; print(\"available:\", have)\n","\n","# ---- (1) country-level: silence vs governance (Spearman + country-bootstrap CI) ----\n","cm = df.groupby(\"iso\").agg(M=(\"M_missing\",\"mean\"), S=(\"S_raw\",\"mean\"), income=(\"income\",\"first\"), country=(\"country\",\"first\"), **{n:(n,\"mean\") for n in have})\n","print(\"\\n=== (1) COUNTRY-LEVEL: mean silence vs governance (Spearman rho, 95% bootstrap CI over countries) ===\")\n","for n in have:\n","    z = cm[[\"M\",n]].dropna()\n","    if len(z) < 30: print(f\"  {n}: too few countries ({len(z)})\"); continue\n","    rho = spearmanr(z.M, z[n])[0]; bs=[]\n","    for _ in range(1000):\n","        b = z.sample(len(z), replace=True, random_state=int(rng.integers(1e9))); bs.append(spearmanr(b.M, b[n])[0])\n","    lo,hi = np.nanpercentile(bs,[2.5,97.5]); print(f\"  M_missing vs {n:9s}: rho={rho:+.2f}  CI[{lo:+.2f},{hi:+.2f}]  n={len(z)}  {'SIGNIFICANT' if lo>0 or hi<0 else 'CI includes 0'}\")\n","if have:\n","    print(\"  Within income group (LIC/LMC/UMC), M_missing vs\", have[0], \":\")\n","    for g_,z in cm.groupby(\"income\"):\n","        z = z[[\"M\",have[0]]].dropna()\n","        if len(z) > 15: print(f\"    {g_}: rho={spearmanr(z.M, z[have[0]])[0]:+.2f} (n={len(z)})\")\n","\n","# ---- (2) panel: does worse governance precede more silence?  year FE, country-clustered SE ----\n","if have:\n","    print(\"\\n=== (2) PANEL: M_missing_t ~ governance_(t-1) + year FE, SE clustered by country ===\")\n","    d = df.sort_values([\"iso\",\"year\"]).copy()\n","    for n in have:\n","        d[n+\"_l1\"] = d.groupby(\"iso\")[n].shift(1)\n","        z = d.dropna(subset=[\"M_missing\", n+\"_l1\"])\n","        if len(z) < 300: continue\n","        X = pd.concat([z[[n+\"_l1\"]], pd.get_dummies(z.year, drop_first=True, dtype=float)], axis=1); X = sm.add_constant(X)\n","        r = sm.OLS(z.M_missing, X).fit(cov_type=\"cluster\", cov_kwds={\"groups\": z.iso.astype(\"category\").cat.codes})\n","        print(f\"  {n:9s}: coef={r.params[n+'_l1']:+.4f}  p={r.pvalues[n+'_l1']:.4f}  n={len(z)}\")\n","\n","# ---- (3) event study around sudden reporting collapses ----\n","d = sil.sort_values([\"iso\",\"year\"]).copy(); d[\"dM\"] = d.groupby(\"iso\").M_missing.diff()\n","J = d[d.dM>=0.20][[\"iso\",\"country\",\"year\"]]\n","print(\"\\n=== (3) EVENT STUDY: M_missing around reporting-collapse year (t=0) ===\")\n","print(\"episodes:\", len(J), \"|\", \", \".join(f\"{r.country} {r.year}\" for r in J.itertuples()))\n","rows=[]\n","for k in range(-4,4):\n","    v=[];\n","    for r in J.itertuples():\n","        x = d[(d.iso==r.iso)&(d.year==r.year+k)].M_missing\n","        if len(x): v.append(x.iloc[0])\n","    rows.append((k, np.mean(v) if v else np.nan, len(v)))\n","base = d[~d.iso.isin(J.iso)].M_missing.mean()\n","print(pd.DataFrame(rows, columns=[\"t\",\"mean_M_collapse_countries\",\"n\"]).round(3).to_string(index=False)); print(f\"  all other countries, overall mean M = {base:.3f}\")\n","\n","# ---- figures (large fonts, high contrast) ----\n","plt.rcParams.update({\"font.size\":13,\"axes.labelsize\":14,\"axes.titlesize\":15,\"legend.fontsize\":12,\"axes.linewidth\":1.3})\n","fig, ax = plt.subplots(figsize=(8,5))\n","for r in J.itertuples():\n","    s_ = d[(d.iso==r.iso)&(d.year.between(r.year-5, r.year+3))]\n","    ax.plot(s_.year-r.year, s_.M_missing, marker=\"o\", lw=2, label=f\"{r.country} {r.year}\")\n","ax.axvline(0, color=\"k\", ls=\"--\", lw=1.5); ax.set_xlabel(\"Years relative to reporting collapse\"); ax.set_ylabel(\"Share of annual series missing\")\n","ax.legend(ncol=2, frameon=True); ax.grid(alpha=.3); fig.tight_layout(); fig.savefig(\"fig_event_study.png\", dpi=300); plt.close(fig)\n","if have:\n","    n = have[0]; z = cm[[\"M\",n,\"country\"]].dropna()\n","    fig, ax = plt.subplots(figsize=(7.5,5.5)); ax.scatter(z[n], z.M, s=40, c=\"#1f4e79\", edgecolor=\"k\", lw=.6)\n","    for r in z.sort_values(\"M\", ascending=False).head(8).itertuples(): ax.annotate(r.country.split(\",\")[0], (getattr(r,n), r.M), fontsize=11, xytext=(4,4), textcoords=\"offset points\")\n","    ax.set_xlabel(f\"Mean {n} (higher = better)\"); ax.set_ylabel(\"Mean share of series missing (2000-2024)\"); ax.grid(alpha=.3)\n","    fig.tight_layout(); fig.savefig(\"fig_silence_vs_governance.png\", dpi=300); plt.close(fig)\n","cm.reset_index().to_csv(\"country_level_silence_governance.csv\", index=False)\n","print(\"\\nSaved: fig_event_study.png, fig_silence_vs_governance.png, country_level_silence_governance.csv\")\n","try:\n","    from google.colab import files\n","    for f in [\"fig_event_study.png\",\"fig_silence_vs_governance.png\",\"country_level_silence_governance.csv\"]:\n","        if os.path.exists(f): files.download(f)\n","except Exception: pass"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":731},"id":"jsDosfW6Z1YA","executionInfo":{"status":"ok","timestamp":1794139510630,"user_tz":-360,"elapsed":9233,"user":{"displayName":"Protik Das","userId":"05892790478659477414"}},"outputId":"7f15936f-7384-4493-d837-18ab657b8421"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["