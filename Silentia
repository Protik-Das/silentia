rap\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","from google.colab import files\n","\n","# Confirm that the source data are already loaded\n","if 'panel' not in globals():\n","    raise NameError(\"Data not found. First run the no-upload cell that loads the SILENTIA panel dataset and creates `panel`.\")\n","\n","# Output folder and publication settings\n","OUT = '/content/SILENTIA_Figure2'\n","os.makedirs(OUT, exist_ok=True)\n","CM = 1 / 2.54\n","DPI = 300\n","INK, MID = '#222222', '#666666'\n","GROUP_ORDER = ['LIC', 'LMC', 'UMC']\n","GROUP_LABELS = {'LIC': 'Low income', 'LMC': 'Lower-middle income', 'UMC': 'Upper-middle income'}\n","GROUP_MARKERS = {'LIC': 'o', 'LMC': 's', 'UMC': '^'}\n","GROUP_COLORS = {'LIC': '#333333', 'LMC': '#777777', 'UMC': '#BBBBBB'}\n","\n","plt.rcParams.update({\n","    'font.family': 'DejaVu Sans',\n","    'font.size': 7.2,\n","    'axes.labelsize': 7.2,\n","    'axes.titlesize': 7.4,\n","    'xtick.labelsize': 6.5,\n","    'ytick.labelsize': 6.2,\n","    'axes.edgecolor': INK,\n","    'axes.linewidth': 0.65,\n","    'axes.spines.top': False,\n","    'axes.spines.right': False,\n","    'axes.facecolor': 'white',\n","    'figure.facecolor': 'white',\n","    'savefig.facecolor': 'white',\n","    'pdf.fonttype': 42,\n","    'ps.fonttype': 42\n","})\n","\n","# Prepare data without changing the underlying observations\n","p = panel.copy()\n","p['year'] = pd.to_numeric(p['year'], errors='raise').astype(int)\n","p['M_missing'] = pd.to_numeric(p['M_missing'], errors='coerce')\n","p = p.sort_values(['iso', 'year']).copy()\n","if p.duplicated(['iso', 'year']).any():\n","    raise ValueError('Duplicate country-year rows found in the panel dataset.')\n","\n","annual = (p.groupby(['year', 'income'], as_index=False)['M_missing']\n","          .mean().rename(columns={'M_missing': 'mean_M'}))\n","country_mean = (p.groupby(['iso', 'country', 'income'], as_index=False)['M_missing']\n","                .mean().rename(columns={'M_missing': 'mean_M'}))\n","country_mean = country_mean.dropna(subset=['mean_M']).sort_values('mean_M', ascending=False)\n","top15 = country_mean.head(15).sort_values('mean_M', ascending=True).copy()\n","\n","# Three-panel figure. Panel (c) is deliberately wider to keep country names\n","# outside the bars with enough white space.\n","fig, axes = plt.subplots(\n","    1, 3,\n","    figsize=(16 * CM, 7.2 * CM),\n","    gridspec_kw={'width_ratios': [1.25, 0.90, 2.15]}\n",")\n","\n","# (a) Annual mean missing share by income group\n","ax = axes[0]\n","for g in GROUP_ORDER:\n","    z = annual[annual['income'] == g]\n","    if not z.empty:\n","        ax.plot(z['year'], z['mean_M'], marker=GROUP_MARKERS[g], ms=2.7,\n","                lw=1.1, color=GROUP_COLORS[g], label=GROUP_LABELS[g])\n","ax.set_xlabel('Year')\n","ax.set_ylabel('Mean missing share (M)')\n","ax.legend(frameon=False, fontsize=5.9, loc='best', handlelength=1.5)\n","ax.set_title('(a) Mean M by year and income group', loc='left', fontsize=7.1, pad=6)\n","ax.grid(axis='y', linestyle=':', linewidth=0.4, alpha=0.45)\n","ax.set_axisbelow(True)\n","\n","# (b) Country-level distribution by income group\n","ax = axes[1]\n","box_data = [country_mean.loc[country_mean['income'] == g, 'mean_M'].dropna().values\n","            for g in GROUP_ORDER]\n","parts = ax.boxplot(\n","    box_data, patch_artist=True, widths=0.55, showfliers=False,\n","    medianprops={'color': 'black', 'linewidth': 0.9},\n","    boxprops={'edgecolor': MID, 'linewidth': 0.75},\n","    whiskerprops={'color': MID, 'linewidth': 0.75},\n","    capprops={'color': MID, 'linewidth': 0.75}\n",")\n","for patch in parts['boxes']:\n","    patch.set_facecolor('white')\n","for i, g in enumerate(GROUP_ORDER, start=1):\n","    vals = box_data[i - 1]\n","    if len(vals):\n","        rng = np.random.default_rng(100 + i)\n","        jitter = rng.normal(0, 0.045, len(vals))\n","        ax.scatter(np.full(len(vals), i) + jitter, vals, s=7,\n","                   color=GROUP_COLORS[g], alpha=0.62, linewidths=0, zorder=3)\n","ax.set_xticks([1, 2, 3], ['LIC', 'LMC', 'UMC'])\n","ax.set_ylabel('Country mean M')\n","ax.set_title('(b) Country-level mean M', loc='left', fontsize=7.1, pad=6)\n","ax.grid(axis='y', linestyle=':', linewidth=0.4, alpha=0.45)\n","ax.set_axisbelow(True)\n","\n","# (c) Top 15 countries. Labels are wrapped and placed completely outside bars.\n","ax = axes[2]\n","labels = [textwrap.fill(str(name), width=19, break_long_words=False)\n","          for name in top15['country']]\n","y = np.arange(len(top15))\n","ax.barh(y, top15['mean_M'].to_numpy(), height=0.66,\n","       color='#858585', edgecolor='#333333', linewidth=0.35, zorder=2)\n","ax.set_yticks(y)\n","ax.set_yticklabels(labels, fontsize=5.8, ha='right')\n","ax.tick_params(axis='y', length=0, pad=5)\n","ax.set_xlabel('Country mean M')\n","ax.set_title('(c) 15 most silent countries', loc='left', fontsize=7.1, pad=6)\n","ax.set_xlim(0, max(0.5, float(top15['mean_M'].max()) * 1.12))\n","ax.grid(axis='x', linestyle=':', linewidth=0.45, alpha=0.5, zorder=0)\n","ax.set_axisbelow(True)\n","ax.invert_yaxis()\n","\n","# Extra horizontal gap separates country labels from panel (b).\n","fig.subplots_adjust(left=0.075, right=0.99, bottom=0.17, top=0.86, wspace=0.92)\n","\n","# Save all formats\n","stem = 'Figure_2_Anatomy_of_Silence'\n","fig.savefig(f'{OUT}/{stem}.jpg', dpi=DPI, format='jpeg', pil_kwargs={'quality': 95})\n","fig.savefig(f'{OUT}/{stem}.tif', dpi=DPI, format='tiff', pil_kwargs={'compression': 'tiff_lzw'})\n","fig.savefig(f'{OUT}/{stem}.eps', format='eps')\n","plt.show()\n","plt.close(fig)\n","\n","print('Figure 2 saved successfully:')\n","for ext in ['jpg', 'tif', 'eps']:\n","    print(f'{OUT}/{stem}.{ext}')\n","\n","# Download one ZIP to avoid Colab/browser blocking multiple downloads\n","import zipfile\n","zip_path = f'{OUT}/SILENTIA_Figure2_All_Formats.zip'\n","with zipfile.ZipFile(zip_path, 'w', compression=zipfile.ZIP_DEFLATED) as zf:\n","    for ext in ['jpg', 'tif', 'eps']:\n","        fpath = f'{OUT}/{stem}.{ext}'\n","        zf.write(fpath, arcname=os.path.basename(fpath))\n","files.download(zip_path)"],"metadata":{"id":"eEl57OP_zWuO","executionInfo":{"status":"ok","timestamp":1794991036980,"user_tz":-360,"elapsed":5176,"user":{"displayName":"Protik Das","userId":"05892790478659477414"}},"outputId":"962e76ee-6178-425f-ee41-71fc4a6fec40","colab":{"base_uri":"https://localhost:8080/","height":370}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stderr","text":["WARNING:matplotlib.backends.backend_ps:The PostScript backend does not support transparency; partially transparent artists will be rendered opaque.\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 629.921x283.465 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Figure 2 saved successfully:\n","/content/SILENTIA_Figure2/Figure_2_Anatomy_of_Silence.jpg\n","/content/SILENTIA_Figure2/Figure_2_Anatomy_of_Silence.tif\n","/content/SILENTIA_Figure2/Figure_2_Anatomy_of_Silence.eps\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      