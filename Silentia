sAxes, ha=\"right\",\n","        fontsize=7.5, color=GREY)\n","\n","save_figure(fig, \"Figure_4_Change_in_AUC\")\n","\n","\n","# ============================================================\n","# FIGURE 6 | EVENT STUDY: RIGHT-PANEL ESTIMATES\n","# Exact DiD estimates from manuscript\n","# ============================================================\n","\n","periods = [\"t\", \"t+1\", \"t+2\", \"t+3\"]\n","effect = np.array([.273, .290, .257, .286])\n","lo = np.array([.241, .265, .199, .252])\n","hi = np.array([.304, .316, .309, .322])\n","episodes = [10, 7, 5, 5]\n","\n","fig, ax = plt.subplots(figsize=(7.5, 4.8))\n","y = np.arange(4)\n","\n","for i in range(4):\n","    ax.plot([lo[i], hi[i]], [i, i],\n","            color=BLUE, linewidth=2)\n","    ax.scatter(effect[i], i, color=ORANGE,\n","               s=55, edgecolor=\"white\", zorder=3)\n","    ax.text(hi[i]+.006, i,\n","            f\"{effect[i]:.3f}  (n={episodes[i]})\",\n","            va=\"center\", fontsize=8, color=DARK)\n","\n","ax.set_yticks(y)\n","ax.set_yticklabels(periods)\n","ax.invert_yaxis()\n","ax.set_xlim(.15, .37)\n","ax.set_xlabel(\"Difference-in-differences in missing share (M)\")\n","ax.set_title(\"Reporting-collapse effect relative to matched controls\",\n","             loc=\"left\", color=NAVY,\n","             fontweight=\"bold\", pad=12)\n","ax.grid(axis=\"x\", color=LIGHT, linewidth=.7)\n","ax.set_axisbelow(True)\n","\n","save_figure(fig, \"Figure_6_Event_Study_Effects\")\n","\n","print(\"\\nFinished available figures.\")\n","print(\"Saved in:\", OUT)\n","print(\"PDF and 600 DPI TIFF versions created.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"T1Se1pSFl0oo","executionInfo":{"status":"ok","timestamp":1794987525187,"user_tz":-360,"elapsed":7127,"user":{"displayName":"Protik Das","userId":"05892790478659477414"}},"outputId":"7a7b7582-320e-4290-8d31-b83f4b802cb4"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain