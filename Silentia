ssage to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_39a3fc09-2803-4a65-b1e7-b4423b80a2a9\", \"provenance.json\", 5335)"]},"metadata":{}}],"source":["# ===================== STEP 1: South Asia raw panel (World Bank API only) =====================\n","import requests, pandas as pd, numpy as np, json, time, datetime as dt\n","pd.set_option(\"display.width\", 220); pd.set_option(\"display.max_columns\", 50); pd.set_option(\"display.max_rows\", 200)\n","\n","COUNTRIES = {\"BGD\":\"Bangladesh\",\"IND\":\"India\",\"PAK\":\"Pakistan\",\"LKA\":\"Sri Lanka\",\n","             \"NPL\":\"Nepal\",\"BTN\":\"Bhutan\",\"MDV\":\"Maldives\",\"AFG\":\"Afghanistan\"}\n","Y0, Y1 = 2000, 2024\n","\n","INDICATORS = {\n"," \"GDP_pc_USD\":\"NY.GDP.PCAP.CD\", \"Inflation_pct\":\"FP.CPI.TOTL.ZG\",\n"," \"Exchange_rate_LCU_USD\":\"PA.NUS.FCRF\", \"Reserves_USD\":\"FI.RES.TOTL.CD\",\n"," \"ExtDebt_pct_GNI\":\"DT.DOD.DECT.GN.ZS\", \"Remittances_pct_GDP\":\"BX.TRF.PWKR.DT.GD.ZS\",\n"," \"Exports_pct_GDP\":\"NE.EXP.GNFS.ZS\", \"Unemployment_pct\":\"SL.UEM.TOTL.ZS\",\n"," \"School_enrol_primary_pct\":\"SE.PRM.ENRR\", \"Under5_mortality\":\"SH.DYN.MORT\",\n"," \"Stunting_pct\":\"SH.STA.STNT.ZS\", \"Poverty_215_pct\":\"SI.POV.DDAY\",\n"," \"Population\":\"SP.POP.TOTL\", \"Food_prod_index\":\"AG.PRD.FOOD.XD\",\n"," \"Cereal_yield_kg_ha\":\"AG.YLD.CREL.KG\", \"Forest_area_pct\":\"AG.LND.FRST.ZS\",\n"," \"CO2_pc\":\"EN.GHG.CO2.PC.CE.AR5\",\n","}\n","# annual macro/administrative series only (survey-based series excluded: gaps are by design)\n","S_SET = [\"GDP_pc_USD\",\"Inflation_pct\",\"Exchange_rate_LCU_USD\",\"Reserves_USD\",\"ExtDebt_pct_GNI\",\n","         \"Remittances_pct_GDP\",\"Exports_pct_GDP\",\"Unemployment_pct\",\"School_enrol_primary_pct\",\n","         \"Food_prod_index\",\"Cereal_yield_kg_ha\"]\n","R_SET = [c for c in S_SET if c != \"Exchange_rate_LCU_USD\"]   # pegged currencies are legitimately constant\n","\n","def fetch_indicator(code, retries=4):\n","    url = f\"https://api.worldbank.org/v2/country/{';'.join(COUNTRIES)}/indicator/{code}\"\n","    params = {\"format\":\"json\",\"per_page\":20000,\"date\":f\"{Y0}:{Y1}\"}\n","    for k in range(retries):\n","        try:\n","            r = requests.get(url, params=params, timeout=60); r.raise_for_status()\n","            js = r.json()\n","            if not isinstance(js, list) or len(js) < 2 or js[1] is None:\n","                return None, None, r.url\n","            return js[1], js[0].get(\"lastupdated\"), r.url\n","        except Exception as e:\n","            time.sleep(2*(k+1))\n","    return None, None, url\n","\n","rows_all, prov = [], {}\n","print(\"Downloading...\")\n","for name, code in INDICATORS.items():\n","    rows, lastupd, url = fetch_indicator(code)\n","    n = 0\n","    if rows:\n","        for rr in rows:\n","            iso = rr[\"countryiso3code\"]\n","            if iso in COUNTRIES:\n","                v = rr[\"value\"]\n","                rows_all.append((iso, int(rr[\"date\"]), name, np.nan if v is None else float(v)))\n","                n += 0 if v is None else 1\n","    prov[name] = {\"code\":code, \"url\":url, \"lastupdated\":lastupd, \"n_obs\":n,\n","                  \"retrieved_at_utc\":dt.datetime.utcnow().isoformat()}\n","    print(f\"  {name:26s} {code:22s} obs={n:3d}/{len(COUNTRIES)*(Y1-Y0+1)}\")\n","\n","long = pd.DataFrame(rows_all, columns=[\"iso\",\"year\",\"ind\",\"value\"])\n","idx = pd.MultiIndex.from_product([list(COUNTRIES), range(Y0, Y1+1)], names=[\"iso\",\"year\"])\n","wide = long.pivot(index=[\"iso\",\"year\"], columns=\"ind\", values=\"value\").reindex(idx).reindex(columns=list(INDICATORS))\n","\n","print(\"\\n=== PANEL ===\")\n","print(\"shape:\", wide.shape, \"| countries:\", len(COUNTRIES), \"| years:\", Y0, \"-\", Y1)\n","cov = (wide.notna().mean()*100).round(1).rename(\"coverage_%\").to_frame()\n","cov[\"in_silence_set\"] = [c in S_SET for c in cov.index]\n","print(\"\\n=== INDICATOR COVERAGE (raw, before any imputation) ===\")\n","print(cov.to_string())\n","\n","print(\"\\n=== OBSERVED COUNT BY COUNTRY (all indicators) ===\")\n","print((wide.notna().groupby(level=0).sum().sum(axis=1)).rename(\"observed_cells\").to_frame().assign(\n","      total_cells=len(INDICATORS)*(Y1-Y0+1)).to_string())\n","\n","# ---------- reporting lag: how many years behind the last published value is ----------\n","lag = pd.DataFrame(index=list(COUNTRIES), columns=S_SET, dtype=float)\n","for iso in COUNTRIES:\n","    for c in S_SET:\n","        s = wide.loc[iso, c].dropna()\n","        lag.loc[iso, c] = (Y1 - s.index.max()) if len(s) else np.nan\n","print(\"\\n=== REPORTING LAG in years (Y1 - last observed year); NaN = never reported ===\")\n","print(lag.to_string())\n","\n","# ---------- objective silence components (no crisis labels, no imputation) ----------\n","recs = []\n","for iso in COUNTRIES:\n","    d = wide.loc[iso]\n","    M = d[S_SET].isna().mean(axis=1)                                    # share of series missing\n","    prev = d[R_SET].shift(1)\n","    both = d[R_SET].notna() & prev.notna()\n","    R = (((d[R_SET] == prev) & both).sum(axis=1) / both.sum(axis=1).replace(0, np.nan)).fillna(0)   # frozen values\n","    run = pd.DataFrame(0, index=d.index, columns=S_SET)\n","    for c in S_SET:\n","        cnt = 0\n","        for y in d.index:\n","            cnt = cnt + 1 if pd.isna(d.at[y, c]) else 0\n","            run.at[y, c] = cnt\n","    G = (run.clip(upper=5) / 5).mean(axis=1)                            # current gap-run length (cap 5y)\n","    recs.append(pd.DataFrame({\"iso\":iso, \"year\":d.index, \"M_missing\":M.values,\n","                              \"R_frozen\":R.values, \"G_gaprun\":G.values}))\n","sil = pd.concat(recs, ignore_index=True)\n","sil[\"S_raw\"] = (sil.M_missing + sil.R_frozen + sil.G_gaprun) / 3         # equal weights, no tuning\n","sil[\"S_rel\"] = sil.S_raw - sil.groupby(\"year\").S_raw.transform(\"mean\")   # peer-relative (removes global publication lag)\n","\n","print(\"\\n=== SILENCE: mean by year across countries (shows global publication lag) ===\")\n","print(sil.groupby(\"year\")[[\"M_missing\",\"R_frozen\",\"G_gaprun\",\"S_raw\"]].mean().round(3).to_string())\n","print(\"\\n=== SILENCE: mean by country ===\")\n","print(sil.groupby(\"iso\")[[\"M_missing\",\"R_frozen\",\"G_gaprun\",\"S_raw\",\"S_rel\"]].mean().round(3).to_string())\n","print(\"\\n=== BANGLADESH silence by year ===\")\n","print(sil[sil.iso==\"BGD\"].set_index(\"year\")[[\"M_missing\",\"R_frozen\",\"G_gaprun\",\"S_raw\",\"S_rel\"]].round(3).to_string())\n","\n","# ---------- save everything ----------\n","wide.reset_index().to_csv(\"panel_raw_nan.csv\", index=False)\n","sil.to_csv(\"silence_components.csv\", index=False)\n","json.dump(prov, open(\"provenance.json\",\"w\"), indent=2)\n","print(\"\\nSaved: panel_raw_nan.csv, silence_components.csv, provenance.json  (in /content)\")\n","try:\n","    from google.colab import files\n","    for f in [\"panel_raw_nan.csv\",\"silence_components.csv\",\"provenance.json\"]: files.download(f)\n","except Exception: pass"]},{"cell_type":"code","source":["# ===== STEP 1b: Global low/middle-income panel (World Bank API only, NaN kept, no imputation) =====\n","import requests, pandas as pd, numpy as np, json, time, datetime as dt\n","pd.set_option(\"display.width\", 200); pd.set_option(\"display.max_columns\", 30)\n","Y0, Y1 = 2000, 2024\n","\n","def get(url, params, tries=4):\n","    for k in range(tries):\n","        try:\n","            r = requests.get(url, params=params, timeout=90); r.raise_for_status(); return r.json(), r.url\n","        except Exception: time.sleep(2*(k+1))\n","    return None, url\n","\n","meta, _ = get(\"https://api.worldbank.org/v2/country\", {\"format\":\"json\",\"per_page\":400})\n","C = {c[\"id\"]:(c[\"name\"], c[\"incomeLevel\"][\"id\"], c[\"region\"][\"value\"]) for c in meta[1]\n","     if c[\"region\"][\"value\"] != \"Aggregates\" and c[\"incomeLevel\"][\"id\"] in (\"LIC\",\"LMC\",\"UMC\")}\n","print(\"Low/middle-income countries:\", len(C))\n","\n","IND = {\"GDP_pc_USD\":\"NY.GDP.PCAP.CD\",\"Inflation_pct\":\"FP.CPI.TOTL.ZG\",\"Exchange_rate_LCU_USD\":\"PA.NUS.FCRF\",\n","       \"Reserves_USD\":\"FI.RES.TOTL.CD\",\"ExtDebt_pct_GNI\":\"DT.DOD.DECT.GN.ZS\",\"Remittances_pct_GDP\":\"BX.TRF.PWKR.DT.GD.ZS\",\n","       \"Exports_pct_GDP\":\"NE.EXP.GNFS.ZS\",\"Unemployment_pct\":\"SL.UEM.TOTL.ZS\",\"School_enrol_primary_pct\":\"SE.PRM.ENRR\",\n","       \"Food_prod_index\":\"AG.PRD.FOOD.XD\",\"Cereal_yield_kg_ha\":\"AG.YLD.CREL.KG\",\"Population\":\"SP.POP.TOTL\"}\n","S_SET = [k for k in IND if k != \"Population\"]                     # annual macro/admin series\n","R_SET = [c for c in S_SET if c != \"Exchange_rate_LCU_USD\"]        # pegged currencies legitimately constant\n","\n","rows, prov = [], {}\n","for name, code in IND.items():\n","    js, url = get(f\"https://api.worldbank.org/v2/country/all/indicator/{code}\",\n","                  {\"format\":\"json\",\"per_page\":20000,\"date\":f\"{Y0}:{Y1}\"})\n","    n = 0\n","    if js and len(js) > 1 and js[1]:\n","        if js[0].get(\"pages\", 1) > 1: print(\"WARNING: more pages for\", name)\n","        for r in js[1]:\n","            iso = r[\"countryiso3code\"]\n","            if iso in C:\n","                v = r[\"value\"]; rows.append((iso, int(r[\"date\"]), name, np.nan if v is None else float(v))); n += v is not None\n","    prov[name] = {\"code\":code, \"url\":url, \"lastupdated\":(js[0].get(\"lastupdated\") if js else None),\n","                  \"n_obs\":n, \"retrieved_at_utc\":dt.datetime.now(dt.timezone.utc).isoformat()}\n","    print(f\"  {name:26s} obs={n}\")\n","\n","long = pd.DataFrame(rows, columns=[\"iso\",\"year\",\"ind\",\"value\"])\n","idx = pd.MultiIndex.from_product([sorted(C), range(Y0, Y1+1)], names=[\"iso\",\"year\"])\n","wide = long.pivot(index=[\"iso\",\"year\"], columns=\"ind\", values=\"value\").reindex(idx).reindex(columns=list(IND))\n","wide[\"income\"] = [C[i][1] for i in wide.index.get_level_values(0)]\n","wide[\"region\"] = [C[i][2] for i in wide.index.get_level_values(0)]\n","\n","# ---- objective silence components (raw missingness, before any imputation) ----\n","recs = []\n","for iso in sorted(C):\n","    d = wide.loc[iso]\n","    M = d[S_SET].isna().mean(axis=1)\n","    prev = d[R_SET].shift(1); both = d[R_SET].notna() & prev.notna()\n","    R = (((d[R_SET] == prev) & both).sum(axis=1) / both.sum(axis=1).replace(0, np.nan)).fillna(0)\n","    run = pd.DataFrame(0, index=d.index, columns=S_SET)\n","    for c in S_SET:\n","        cnt = 0\n","        for y in d.index:\n","            cnt = cnt + 1 if pd.isna(d.at[y, c]) else 0\n","            run.at[y, c] = cnt\n","    G = (run.clip(upper=5) / 5).mean(axis=1)\n","    recs.append(pd.DataFrame({\"iso\":iso, \"year\":d.index, \"M_missing\":M.values, \"R_frozen\":R.values, \"G_gaprun\":G.values}))\n","sil = pd.concat(recs, ignore_index=True)\n","sil[\"S_raw\"] = (sil.M_missing + sil.R_frozen + sil.G_gaprun) / 3\n","sil[\"S_rel\"] = sil.S_raw - sil.groupby(\"year\").S_raw.transform(\"mean\")\n","sil[\"income\"] = sil.iso.map(lambda i: C[i][1]); sil[\"country\"] = sil.iso.map(lambda i: C[i][0])\n","\n","print(\"\\n=== PANEL ===\", wide.shape, \"| countries:\", len(C), \"| country-years:\", len(wide))\n","print(\"Coverage % (silence-set series):\"); print((wide[S_SET].notna().mean()*100).round(1).to_string())\n","print(\"\\n=== Silence by income group ===\"); print(sil.groupby(\"income\")[[\"M_missing\",\"R_frozen\",\"G_gaprun\",\"S_raw\"]].mean().round(3).to_string())\n","print(\"\\n=== Silence by year (mean) ===\"); print(sil.groupby(\"year\")[[\"M_missing\",\"S_raw\"]].mean().round(3).loc[[2000,2005,2010,2015,2019,2020,2021,2022,2023,2024]].to_string())\n","print(\"\\n=== Top 12 countries by mean silence ===\"); print(sil.groupby(\"country\").S_raw.mean().sort_values(ascending=False).head(12).round(3).to_string())\n","print(\"\\n=== Afghanistan silence ===\"); print(sil[sil.iso==\"AFG\"].set_index(\"year\")[[\"M_missing\",\"G_gaprun\",\"S_raw\",\"S_rel\"]].loc[[2018,2019,2020,2021,2022,2023,2024]].round(3).to_string())\n","\n","wide.reset_index().to_csv(\"panel_global_raw_nan.csv\", index=False)\n","sil.to_csv(\"silence_global.csv\", index=False); json.dump(prov, open(\"provenance_global.json\",\"w\"), indent=2)\n","print(\"\\nSaved: panel_global_raw_nan.csv, silence_global.csv, provenance_global.json\")\n","try:\n","    from google.colab import files\n","    for f in [\"panel_global_raw_nan.csv\",\"silence_global.csv\",\"provenance_global.json\"]: files.download(f)\n","except Exception: pass"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"pFPoxq_8HNjz","executionInfo":{"status":"ok","timestamp":1794139139470,"user_tz":-360,"elapsed":8960,"user":{"displayName":"Protik Das","userId":"05892790478659477414"}},"outputId":"522339b5-4f19-43d2-d64a-f6f7d5e55ea7"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Low/middle-income countries: 131\n","  GDP_pc_USD                 obs=3200\n","  Inflation_pct              obs=2931\n","  Exchange_rate_LCU_USD      obs=3094\n","  Reserves_USD               obs=2763\n","  ExtDebt_pct_GNI            obs=2845\n","  Rem