,{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_9d101abf-e94a-4d34-852a-8425c7230662\", \"country_level_silence_governance.csv\", 19197)"]},"metadata":{}}]},{"cell_type":"code","source":["# ===== STEP 5: robustness (microstates, controls, country FE, SPI window, Holm, matched event study) =====\n","import pandas as pd, numpy as np, requests, time, os, warnings\n","warnings.filterwarnings(\"ignore\")\n","from scipy.stats import spearmanr\n","from statsmodels.stats.multitest import multipletests\n","import statsmodels.api as sm\n","rng = np.random.default_rng(42)\n","P, S = \"/content/panel_global_raw_nan.csv\", \"/content/silence_global.csv\"\n","if not (os.path.exists(P) and os.path.exists(S)):\n","    from google.colab import files; files.upload()\n","pan = pd.read_csv(P)[[\"iso\",\"year\",\"Population\"]]; sil = pd.read_csv(S); iso_set = set(sil.iso)\n","\n","def get(url, params, tries=3):\n","    for k in range(tries):\n","        try:\n","            r = requests.get(url, params=params, timeout=90); r.raise_for_status(); return r.json()\n","        except Exception: time.sleep(2*(k+1))\n","    return None\n","def wb(name, code):\n","    js = get(f\"https://api.worldbank.org/v2/country/all/indicator/{code}\", {\"format\":\"json\",\"per_page\":20000,\"date\":\"2000:2024\"})\n","    if js and len(js)>1 and js[1]:\n","        rows = [(r[\"countryiso3code\"], int(r[\"date\"]), r[\"value\"]) for r in js[1] if r[\"countryiso3code\"] in iso_set and r[\"value\"] is not None]\n","        if len(rows) > 200: print(f\"  OK {name} ({len(rows)} rows)\"); return pd.DataFrame(rows, columns=[\"iso\",\"year\",name])\n","    print(f\"  FAIL {name}\"); return None\n","GOV = {\"PolStab\":\"GOV_WGI_PV.EST\",\"GovEff\":\"GOV_WGI_GE.EST\",\"RuleLaw\":\"GOV_WGI_RL.EST\",\"CtrlCorr\":\"GOV_WGI_CC.EST\",\"SPI\":\"IQ.SPI.OVRL\"}\n","df = sil.merge(pan, on=[\"iso\",\"year\"], how=\"left\")\n","for n,c in GOV.items():\n","    x = wb(n,c)\n","    if x is not None: df = df.merge(x, on=[\"iso\",\"year\"], how=\"left\")\n","have = [n for n in GOV if n in df.columns]\n","df[\"logpop\"] = np.log(df.Population)\n","cm = df.groupby(\"iso\").agg(M=(\"M_missing\",\"mean\"), income=(\"income\",\"first\"), country=(\"country\",\"first\"),\n","                           pop=(\"Population\",\"mean\"), logpop=(\"logpop\",\"mean\"), **{n:(n,\"mean\") for n in have})\n","z = lambda s_: (s_-s_.mean())/s_.std()\n","micro = cm[\"pop\"] < 1.5e6\n","print(f\"countries: {len(cm)} | microstates (<1.5M pop): {int(micro.sum())} -> {', '.join(cm[micro].country.str.split(',').str[0].tolist()[:12])}\")\n","\n","def sp(sub, n):\n","    q = sub[[\"M\",n]].dropna(); r,p = spearmanr(q.M,q[n]); bs=[]\n","    for _ in range(500):\n","        b = q.sample(len(q), replace=True, random_state=int(rng.integers(1e9))); bs.append(spearmanr(b.M,b[n])[0])\n","    return r, p, np.nanpercentile(bs,[2.5,97.5]), len(q)\n","print(\"\\n=== A. MAIN vs EXCLUDING MICROSTATES (Spearman; Holm-adjusted p over the 5 main tests) ===\")\n","main = {n:sp(cm,n) for n in have}; hp = multipletests([main[n][1] for n in have], method=\"holm\")[1]\n","rows=[]\n","for i,n in enumerate(have):\n","    r,p,ci,k = main[n]; r2,p2,ci2,k2 = sp(cm[~micro], n)\n","    rows.append([n, f\"{r:+.2f} [{ci[0]:+.2f},{ci[1]:+.2f}]\", f\"{hp[i]:.4f}\", f\"{r2:+.2f} [{ci2[0]:+.2f},{ci2[1]:+.2f}]\", k2])\n","print(pd.DataFrame(rows, columns=[\"indicator\",\"rho_all [95%CI]\",\"Holm_p\",\"rho_excl_micro [95%CI]\",\"n_excl\"]).to_string(index=False))\n","\n","print(\"\\n=== B. CONTROLS: M ~ z(governance) + log(population) + income group (HC3 robust SE, standardised coef) ===\")\n","for n in have:\n","    q = cm[[\"M\",n,\"logpop\",\"income\"]].dropna(); X = pd.concat([z(q[n]).rename(\"z\"), q[[\"logpop\"]], pd.get_dummies(q.income, drop_first=True, dtype=float)], axis=1)\n","    r = sm.OLS(q.M, sm.add_constant(X)).fit(cov_type=\"HC3\"); print(f\"  {n:9s}: coef per 1 SD = {r.params['z']:+.4f}  p={r.pvalues['z']:.4f}  n={len(q)}\")\n","\n","print(\"\\n=== C. PANEL WITH COUNTRY + YEAR FIXED EFFECTS: M_t ~ governance_(t-1), SE clustered by country (within-country effect) ===\")\n","d = df.sort_values([\"iso\",\"year\"]).copy()\n","for n in have:\n","    d[n+\"_l1\"] = d.groupby(\"iso\")[n].shift(1); q = d.dropna(subset=[\"M_missing\",n+\"_l1\"]).copy()\n","    if len(q) < 300: continue\n","    X = q[[n+\"_l1\",\"M_missing\"]].copy()\n","    for _ in range(15): X = X - X.groupby(q.iso.values).transform(\"mean\"); X = X - X.groupby(q.year.values).transform(\"mean\")\n","    r = sm.OLS(X.M_missing, X[[n+\"_l1\"]]).fit(cov_type=\"cluster\", cov_kwds={\"groups\": q.iso.astype(\"category\").cat.codes})\n","    print(f\"  {n:9s}: coef={r.params[n+'_l1']:+.4f}  p={r.pvalues[n+'_l1']:.4f}  n={len(q)}\")\n","\n","if \"SPI\" in have:\n","    print(\"\\n=== D. SPI WINDOW MATCH: mean M over 2016-2022 vs mean SPI (same years) ===\")\n","    w = df[df.year.between(2016,2022)].groupby(\"iso\").agg(M=(\"M_missing\",\"mean\"), SPI=(\"SPI\",\"mean\")).dropna()\n","    r,p = spearmanr(w.M, w.SPI); print(f\"  rho={r:+.2f}  p={p:.2g}  n={len(w)}\")\n","\n","print(\"\\n=== E. EVENT STUDY vs MATCHED CONTROLS (same income group, nearest pre-period M; DiD, bootstrap CI over episodes) ===\")\n","d[\"dM\"] = d.groupby(\"iso\").M_missing.diff(); J = d[d.dM>=0.20][[\"iso\",\"year\",\"income\",\"country\"]]\n","Mw = d.pivot(index=\"iso\", columns=\"year\", values=\"M_missing\"); did = {k:[] for k in range(0,4)}\n","for r in J.itertuples():\n","    pre = Mw.loc[r.iso, r.year-4:r.year-1].mean()\n","    pool = [c for c in Mw.index if c not in set(J.iso) and d[d.iso==c].income.iloc[0]==r.income]\n","    cp = Mw.loc[pool, r.year-4:r.year-1].mean(axis=1).sub(pre).abs().sort_values().head(5).index\n","    cpre = Mw.loc[cp, r.year-4:r.year-1].mean(axis=1)\n","    for k in did:\n","        if r.year+k in Mw.columns and not np.isnan(Mw.loc[r.iso, r.year+k]):\n","            did[k].append((Mw.loc[r.iso, r.year+k]-pre) - (Mw.loc[cp, r.year+k].sub(cpre).mean()))\n","out=[]\n","for k,v in did.items():\n","    v = np.array(v); bs = [np.mean(rng.choice(v,len(v),replace=True)) for _ in range(2000)]\n","    out.append([k, len(v), v.mean(), *np.percentile(bs,[2.5,97.5])])\n","print(pd.DataFrame(out, columns=[\"t\",\"episodes\",\"DiD_in_M\",\"CI_lo\",\"CI_hi\"]).round(3).to_string(index=False))\n","print(\"  (DiD = change in share-missing of collapse country minus change in 5 matched controls; CI excludes 0 => collapse is not a matching artefact)\")"],"metadata":{"id":"gcsKsZzlv3_o","executionInfo":{"status":"ok","timestamp":1794139530582,"user_tz":-360,"elapsed":9655,"user":{"displayName":"Protik Das","userId":"05892790478659477414"}},"outputId":"104c379b-7d25-4d07-8fd0-bcc5391e13c2","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["  OK PolStab (3123 rows)\n","  OK GovEff (3094 rows)\n","  OK RuleLaw (3134 rows)\n","  OK CtrlCorr (3112 rows)\n","  OK SPI (1100 rows)\n","countries: 131 | microstates (<1.5M pop): 26 -> Belize, Bhutan, Comoros, Cabo Verde, Djibouti, Dominica, Fiji, Micronesia, Equatorial Guinea, Grenada, Kiribati, St. Lucia\n","\n","=== A. MAIN vs EXCLUDING MICROSTATES (Spearman; Holm-adjusted p over the 5 main tests) ===\n","indicator     rho_all [95%CI] Holm_p rho_excl_micro [95%CI]  n_excl\n","  PolStab -0.05 [-0.24,+0.14] 0.6097    -0.28 [-0.47,-0.11]     105\n","   GovEff -0.40 [-0.54,-0.24] 0.0000    -0.57 [-0.69,-0.40]     105\n","  RuleLaw -0.22 [-0.39,-0.01] 0.0395    -0.45 [-0.59,-0.28]     105\n"," CtrlCorr -0.18 [-0.34,+0.01] 0.0842    -0.38 [-0.54,-0.20]     105\n","      SPI -0.65 [-0.75,-0.52] 0.0000    -0.64 [-0.75,-0.51]     101\n","\n","=== B. CONTROLS: M ~ z(governance) + log(population) + income group (HC3 robust SE, standardised coef) ===\n","  PolStab  : coef per 1 SD = -0.0284  p=0.2374  n=131\n","  GovEff   : coef per 1 SD = -0.0692  p=0.0000  n=131\n","  RuleLaw  : coef per 1 SD = -0.0461  p=0.0037  n=131\n","  CtrlCorr : coef per 1 SD = -0.0418  p=0.0019  n=131\n","  SPI      : coef per 1 SD = -0.0738  p=0.0000  n=127\n","\n","=== C. PANEL WITH COUNTRY + YEAR FIXED EFFECTS: M_t ~ governance_(t-1), SE clustered by country (within-country effect) ===\n","  PolStab  : coef=-0.0252  p=0.0106  n=2992\n","  GovEff   : coef=-0.0571  p=0.0015  n=2963\n","  RuleLaw  : coef=-0.0565  p=0.0047  n=3003\n","  CtrlCorr : coef=-0.0419  p=0.0418  n=2981\n","  SPI      : coef=-0.0010  p=0.1794  n=973\n","\n","=== D. SPI WINDOW MATCH: mean M over 2016-2022 vs mean SPI (same years) ===\n","  rho=-0.67  p=4.6e-18  n=126\n","\n","=== E. EVENT STUDY vs MATCHED CONTROLS (same income group, nearest pre-period M; DiD, bootstrap CI over episodes) ===\n"," t  episodes  DiD_in_M  CI_lo  CI_hi\n"," 0        10     0.273  0.241  0.302\n"," 1         7     0.290  0.266  0.315\n"," 2         5     0.257  0.201  0.309\n"," 3         5     0.286  0.251  0.322\n","  (DiD = change in share-missing of collapse country minus change in 5 matched controls; CI excludes 0 => collapse is not a matching artefact)\n"]}]},{"cell_type":"code","source":["# =====================================================================================\n","#  LACUNA FIGURE PACK  -  builds 9 publication-quality figures + one Word file (auto-download)\n","#  Needs in /content:  panel_global_raw_nan.csv , silence_global.csv   (from Step 1b)\n","#  Governance/SPI are re-downloaded from the World Bank API.  Runtime: ~2-3 minutes.\n","# =====================================================================================\n","import os, sys, subprocess, time, math, datetime as dt, warnings\n","warnings.filterwarnings(\"ignore\")\n","def _pip(*p): subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", *p], check=False)\n","try: import docx\n","except ImportError: _pip(\"python-docx\"); import docx\n","try: from adjustText import adjust_text\n","except ImportError: _pip(\"adjustText\"); from adjustText import adjust_text\n","import numpy as np, pandas as pd, requests\n","import matplotlib.pyplot as plt\n","from matplotlib.patches import FancyBboxPatch, Rectangle\n","from matplotlib.text import Text\n","from scipy.stats import spearmanr\n","import statsmodels.api as sm\n","from docx import Document\n","from docx.shared import Inches, Pt, RGBColor\n","from docx.enum.text import WD_ALIGN_PARAGRAPH\n","\n","P, S = \"/content/panel_global_raw_nan.csv\", \"/content/silence_global.csv\"\n","OUT = \"lacuna_figs\"; os.makedirs(OUT, exist_ok=True)\n","if not (os.path.exists(P) and os.path.exists(S)):\n","    from google.colab import files; files.upload()\n","rng = np.random.default_rng(42)\n","\n","# ------------------------------- global style (one font, one palette everywhere) -------------------------------\n","plt.rcParams.update({\"font.family\":\"DejaVu Sans\", \"font.size\":10, \"axes.titlesize\":11, \"axes.titleweight\":\"bold\",\n","    \"axes.labelsize\":10.5, \"xtick.labelsize\":9.5, \"ytick.labelsize\":9.5, \"legend.fontsize\":9.5, \"axes.linewidth\":1.0,\n","    \"axes.spines.top\":False, \"axes.spines.right\":False, \"axes.grid\":True, \"grid.alpha\":0.25, \"grid.linewidth\":0.7,\n","    \"figure.facecolor\":\"white\", \"savefig.facecolor\":\"white\", \"pdf.fonttype\":42})\n","BLUE, ORANGE, GREEN, RED, SKY, PURPLE, GREY, INK = \"#0072B2\", \"#E69F00\", \"#009E73\", \"#D55E00\", \"#56B4E9\", \"#CC79A7\", \"#8A8A8A\", \"#222222\"\n","INC = {\"LIC\":RED, \"LMC\":BLUE, \"UMC\":GREEN}; INC_NAME = {\"LIC\":\"Low income\", \"LMC\":\"Lower-middle\", \"UMC\":\"Upper-middle\"}\n","SHORT = {\"Congo, Dem. Rep.\":\"DR Congo\", \"Venezuela, RB\":\"Venezuela\", \"Syrian Arab Republic\":\"Syria\", \"Yemen, Rep.\":\"Yemen\",\n","         \"Korea, Dem. People's Rep.\":\"North Korea\", \"Micronesia, Fed. Sts.\":\"Micronesia\", \"Somalia, Fed. Rep.\":\"Somalia\",\n","         \"Egypt, Arab Rep.\":\"Egypt\", \"Iran, Islamic Rep.\":\"Iran\", \"Lao PDR\":\"Laos\", \"Gambia, The\":\"Gambia\", \"Kyrgyz Republic\":\"Kyrgyzstan\",\n","         \"Turkiye\":\"Turkey\", \"St. Vincent and the Grenadines\":\"St Vincent\", \"Bosnia and Herzegovina\":\"Bosnia\", \"West Bank and Gaza\":\"Palestine\"}\n","sn = lambda c: SHORT.get(c, c.split(\",\")[0])\n","FIGS = []   # (file, title, caption, note)\n","\n","def qa(fig, name):\n","    fig.canvas.draw(); r = fig.canvas.get_renderer(); items = []\n","    for t in fig.findobj(Text):\n","        if t.get_visible() and t.get_text().strip() and abs(t.get_rotation()) < 1:\n","            bb = t.get_window_extent(r); fb = fig.bbox\n","            if bb.width > 2 and bb.height > 2 and bb.x0 >= fb.x0 - 1 and bb.x1 <= fb.x1 + 1 and bb.y0 >= fb.y0 - 1 and bb.y1 <= fb.y1 + 1:\n","                items.append((t.get_text()[:28].replace(\"\\n\",\" \"), bb))\n","    hits = []\n","    for i in range(len(items)):\n","        for j in range(i+1, len(items)):\n","            a, b = items[i][1], items[j][1]\n","            if min(a.x1,b.x1)-max(a.x0,b.x0) > 2 and min(a.y1,b.y1)-max(a.y0,b.y0) > 2: hits.append((items[i][0], items[j][0]))\n","    print(f\"   QA {name}: text overlaps = {len(hits)}\" + (f\"  e.g. {hits[:3]}\" if hits else \"\"))\n","def finish(fig, fname, title, caption, note=\"\"):\n","    qa(fig, fname); path = f\"{OUT}/{fname}.png\"\n","    fig.savefig(path, dpi=300, bbox_inches=\"tight\", pad_inches=0.08); plt.show(); plt.close(fig)\n","    FIGS.append((path, title, caption, note))\n","\n","# ------------------------------------------------ data ------------------------------------------------\n","pan = pd.read_csv(P); sil = pd.read_csv(S); iso_set = set(sil.iso)\n","df = sil.merge(pan[[\"iso\",\"year\",\"Population\"]], on=[\"iso\",\"year\"], how=\"left\").sort_values([\"iso\",\"year\"]).reset_index(drop=True)\n","df[\"country_s\"] = df.country.map(sn)\n","def get(url, params, tries=3):\n","    for k in range(tries):\n","        try:\n","            r = requests.get(url, params=params, timeout=90); r.raise_for_status(); return r.json()\n","        except Exception: time.sleep(2*(k+1))\n","    return None\n","def wb(name, code):\n","    js = get(f\"https://api.worldbank.org/v2/country/all/indicator/{code}\", {\"format\":\"json\",\"per_page\":20000,\"date\":\"2000:2024\"})\n","    if js and len(js) > 1 and js[1]:\n","        rows = [(r[\"countryiso3code\"], int(r[\"date\"]), r[\"value\"]) for r in js[1] if r[\"countryiso3code\"] in iso_set and r[\"value\"] is not None]\n","        if len(rows) > 200: print(f\"  downloaded {name} ({len(rows)} rows)\"); return pd.DataFrame(rows, columns=[\"iso\",\"year\",name])\n","    print(f\"  FAILED {name}\"); return None\n","GOV = {\"PolStab\":\"GOV_WGI_PV.EST\", \"GovEff\":\"GOV_WGI_GE.EST\", \"RuleLaw\":\"GOV_WGI_RL.EST\", \"CtrlCorr\":\"GOV_WGI_CC.EST\", \"SPI\":\"IQ.SPI.OVRL\"}\n","GNAME = {\"PolStab\":\"Political stability\", \"GovEff\":\"Government effectiveness\", \"RuleLaw\":\"Rule of law\", \"CtrlCorr\":\"Control of corruption\", \"SPI\":\"Statistical performance (SPI)\"}\n","print(\"Downloading governance indicators...\")\n","for n, c in GOV.items():\n","    x = wb(n, c)\n","    if x is not None: df = df.merge(x, on=[\"iso\",\"year\"], how=\"left\")\n","have = [n for n in GOV if n in df.columns]\n","cm = df.groupby(\"iso\").agg(M=(\"M_missing\",\"mean\"), G=(\"G_gaprun\",\"mean\"), income=(\"income\",\"first\"), country=(\"country_s\",\"first\"),\n","                           pop=(\"Population\",\"mean\"), **{n:(n,\"mean\") for n in have})\n","micro = cm[\"pop\"] < 1.5e6\n","NUM = {\"n_countries\":int(df.iso.nunique()), \"n_country_years\":int(len(df)), \"n_microstates\":int(micro.sum())}\n","print(\"countries:\", NUM[\"n_countries\"], \"| country-years:\", NUM[\"n_country_years\"])\n","\n","# ===================================== F1  study design =====================================\n","fig, ax = plt.subplots(figsize=(7.2, 4.5)); ax.set_xlim(0,100); ax.set_ylim(0,62); ax.axis(\"off\"); ax.grid(False)\n","fig.canvas.draw(); R_ = fig.canvas.get_renderer()\n","BOXES = []\n","def box(x, y, w, h, head, body, col):\n","    ax.add_patch(FancyBboxPatch((x,y), w, h, boxstyle=\"round,pad=0,rounding_size=1.2\", fc=\"#FFFFFF\", ec=col, lw=1.8, zorder=2))\n","    ax.add_patch(Rectangle((x+0.5,y+h-6.2), w-1.0, 5.7, fc=col, ec=col, lw=0, zorder=3))\n","    th = ax.text(x+w/2, y+h-3.1, head, color=\"white\", ha=\"center\", va=\"center\", fontsize=10, fontweight=\"bold\", zorder=4)\n","    tb = ax.text(x+1.6, y+h-8.0, body, color=INK, ha=\"left\", va=\"top\", fontsize=9, linespacing=1.4, zorder=4)\n","    BOXES.append((x, y, w, h, th, tb))\n","def fit_boxes():\n","    fs = 9.0\n","    while fs > 6.0:\n","        ok = True\n","        for (x, y, w, h, th, tb) in BOXES:\n","            tb.set_fontsize(fs); th.set_fontsize(min(10, fs + 1)); bb = tb.get_window_extent(R_); hb = th.get_window_extent(R_)\n","            (x1, y0), (x0, y1) = ax.transData.transform([(x+w-0.9, y+0.9), (x+0.9, y+h-7.0)])\n","            hx0, hx1 = ax.transData.transform([(x+0.9, 0), (x+w-0.9, 0)])[:, 0]\n","            if bb.x1 > x1 or bb.y0 < y0 or hb.x0 < hx0 or hb.x1 > hx1: ok = False; break\n","        if ok: break\n","        fs -= 0.25\n","    return fs\n","def arrow(x0, y0, x1, y1): ax.annotate(\"\", xy=(x1,y1), xytext=(x0,y0), arrowprops=dict(arrowstyle=\"-|>\", color=INK, lw=1.6), zorder=1)\n","box(1, 36, 30, 24, \"1  DATA\", \"World Bank API only\\n131 low/middle-income\\ncountries, 2000-2024\\n11 annual macro series\", BLUE)\n","box(35, 36, 30, 24, \"2  RAW PANEL\", \"Missing values stay NaN\\nNo imputation\\nNo hand-typed fills\\nProvenance JSON logged\", SKY)\n","box(69, 36, 30, 24, \"3  SILENCE\", \"M  share of series missing\\nR  frozen repeated values\\nG  current gap length\\nS = (M+R+G)/3, peer-relative\", ORANGE)\n","arrow(31.4, 48, 34.6, 48); arrow(65.4, 48, 68.6, 48)\n","ax.plot([84, 84], [36, 31.5], color=INK, lw=1.6, zorder=1); ax.plot([17, 84], [31.5, 31.5], color=INK, lw=1.6, zorder=1)\n","for xx in (17, 50, 84): arrow(xx, 31.5, xx, 27.4)\n","box(1, 1, 32, 26, \"A  EARLY WARNING\", \"Stress event in year t+1\\nLogit and GBM vs persistence\\nHeld-out countries and\\nrolling-origin splits\\nScaler fitted on train only\", GREEN)\n","box(34.5, 1, 31, 26, \"B  GOVERNANCE\", \"Silence vs WGI and SPI\\nSpearman, controls, Holm\\nCountry + year fixed effects\\nMicrostate exclusion\", PURPLE)\n","box(67, 1, 32, 26, \"C  COLLAPSES\", \"Sudden reporting collapses\\nvs 5 matched controls\\nDifference-in-differences\\nBootstrap over episodes\", RED)\n","fit_boxes()\n","finish(fig, \"F1_study_design\", \"Study design and analysis pipeline\",\n","       \"Fig. 1. Study design. All indicators come from the World Bank API and missing values are never imputed. Reporting silence is measured from raw missingness (M), frozen repeated values (R) and current gap length (G). Three independent analyses follow: (A) leakage-controlled early-warning benchmark, (B) association with governance and statistical capacity, (C) event study of sudden reporting collapses against matched controls.\",\n","       \"Schematic; no data plotted.\")\n","\n","# ===================================== F2  data coverage =====================================\n","SER = {\"GDP_pc_USD\":\"GDP per capita\", \"Inflation_pct\":\"Inflation\", \"Exchange_rate_LCU_USD\":\"Exchange rate\", \"Reserves_USD\":\"Reserves\",\n","       \"ExtDebt_pct_GNI\":\"External debt\", \"Remittances_pct_GDP\":\"Remittances\", \"Exports_pct_GDP\":\"Exports\", \"Unemployment_pct\":\"Unemployment\",\n","       \"School_enrol_primary_pct\":\"Primary enrolment\", \"Food_prod_index\":\"Food production\", \"Cereal_yield_kg_ha\":\"Cereal yield\"}\n","ser = [c for c in SER if c in pan.columns]; order = [\"LIC\",\"LMC\",\"UMC\"]\n","cov = pd.DataFrame({g: pan[pan.income==g][ser].notna().mean()*100 for g in order if (pan.income==g).any()})\n","fig = plt.figure(figsize=(7.2, 4.6)); gs = fig.add_gridspec(1, 2, width_ratios=[1.25, 1], wspace=0.55)\n","ax = fig.add_subplot(gs[0]); ax.grid(False)\n","im = ax.imshow(cov.values, cmap=\"Blues\", vmin=60, vmax=100, aspect=\"auto\")\n","ax.set_xticks(range(cov.shape[1])); ax.set_xticklabels([INC_NAME[c] for c in cov.columns], rotation=20, ha=\"right\")\n","ax.set_yticks(range(len(ser))); ax.set_yticklabels([SER[c] for c in ser])\n","for i in range(cov.shape[0]):\n","    for j in range(cov.shape[1]):\n","        v = cov.values[i, j]; ax.text(j, i, f\"{v:.0f}\", ha=\"center\", va=\"center\", fontsize=9, color=\"white\" if v > 85 else INK, fontweight=\"bold\")\n","for s_ in ax.spines.values(): s_.set_visible(False)\n","ax.set_title(\"(a) Observed share of country-years (%)\", loc=\"left\", fontsize=10.5)\n","cb = fig.colorbar(im, ax=ax, fraction=0.05, pad=0.03); cb.outline.set_visible(False)\n","ax2 = fig.add_subplot(gs[1]); k = df.M_missing.mul(len(ser)).round().clip(upper=5).astype(int); share = k.value_counts(normalize=True).sort_index()*100\n","lab = [str(i) if i < 5 else \"5+\" for i in share.index]\n","bars = ax2.bar(lab, share.values, color=SKY, edgecolor=BLUE, lw=1.2)\n","for b_, v in zip(bars, share.values): ax2.text(b_.get_x()+b_.get_width()/2, v+1.2, f\"{v:.0f}%\", ha=\"center\", fontsize=9)\n","ax2.set_ylim(0, share.max()*1.18); ax2.set_xlabel(\"Series missing in a country-year (of 11)\"); ax2.set_ylabel(\"Share of country-years (%)\")\n","ax2.set_title(\"(b) Missingness per country-year\", loc=\"left\", fontsize=10.5)\n","finish(fig, \"F2_data_coverage\", \"Data coverage before any imputation\",\n","       f\"Fig. 2. Raw data coverage of the {NUM['n_country_years']:,}-row country-year panel ({NUM['n_countries']} low- and middle-income countries, 2000-2024). (a) Share of country-years with an observed value, by indicator and income group. (b) Number of the 11 annual series missing in a country-year.\",\n","       \"Source: World Bank WDI API; values are raw, no imputation.\")\n","\n","# ===================================== F3  anatomy of silence =====================================\n","fig = plt.figure(figsize=(7.2, 8.4)); gs = fig.add_gridspec(2, 2, height_ratios=[1, 1.25], hspace=0.38, wspace=0.28)\n","ax = fig.add_subplot(gs[0, 0]); yr = df.groupby([\"year\",\"income\"]).M_missing.mean().unstack()\n","for g in order:\n","    if g in yr: ax.plot(yr.index, yr[g], color=INC[g], lw=2.2, label=INC_NAME[g])\n","ax.set_xlabel(\"Year\"); ax.set_ylabel(\"Mean share of series missing\"); ax.set_title(\"(a) Silence over time\", loc=\"left\", fontsize=10.5)\n","ax.legend(frameon=False, loc=\"upper left\"); ax.set_xticks([2000, 2008, 2016, 2024])\n","ax = fig.add_subplot(gs[0, 1]); data = [cm[cm.income==g].M.values for g in order if (cm.income==g).any()]; gl = [g for g in order if (cm.income==g).any()]\n","bp = ax.boxplot(data, widths=0.5, patch_artist=True, showfliers=False, medianprops=dict(color=INK, lw=2))\n","for p_, g in zip(bp[\"boxes\"], gl): p_.set(facecolor=INC[g], alpha=0.35, edgecolor=INC[g], lw=1.5)\n","for i, g in enumerate(gl, 1): ax.scatter(i + rng.uniform(-0.17, 0.17, len(data[i-1])), data[i-1], s=12, color=INC[g], alpha=0.8, zorder=3, edgecolor=\"white\", lw=0.3)\n","ax.set_xticks(range(1, len(gl)+1)); ax.set_xticklabels([INC_NAME[g] for g in gl], rotation=15, ha=\"right\"); ax.set_ylabel(\"Country mean share missing\")\n","ax.set_title(\"(b) Silence by income group\", loc=\"left\", fontsize=10.5)\n","ax = fig.add_subplot(gs[1, :]); top = cm.sort_values(\"M\", ascending=False).head(15).iloc[::-1]\n","ax.barh(top.country, top.M, color=[INC.get(i, GREY) for i in top.income], edgecolor=\"white\", height=0.72)\n","for i, v in enumerate(top.M): ax.text(v + 0.006, i, f\"{v:.2f}\", va=\"center\", fontsize=9)\n","ax.set_xlim(0, top.M.max()*1.14); ax.set_xlabel(\"Mean share of annual series missing, 2000-2024\"); ax.set_title(\"(c) The 15 most silent countries\", loc=\"left\", fontsize=10.5)\n","ax.grid(axis=\"y\", visible=False)\n","handles = [Rectangle((0,0),1,1,fc=INC[g]) for g in order]; ax.legend(handles, [INC_NAME[g] for g in order], frameon=False, loc=\"lower right\")\n","finish(fig, \"F3_anatomy_of_silence\", \"Anatomy of reporting silence\",\n","       \"Fig. 3. Reporting silence measured from raw missingness. (a) Mean share of the 11 annual series missing, by year and income group. (b) Distribution of country-level means by income group (points are countries). (c) The 15 countries with the highest mean silence.\",\n","       \"Silence M = share of the 11 annual series missing in a country-year (no imputation).\")\n","\n","# ===================================== F4  predictive benchmark (values from Step 3 output) =====================================\n","MOD = [\"persistence\",\"macro_LR\",\"macro+silence_LR\",\"macro_GBM\",\"macro+silence_GBM\",\"silence_LR\"]\n","MLAB = {\"persistence\":\"Persistence\", \"macro_LR\":\"Macro, logit\", \"macro+silence_LR\":\"Macro + silence, logit\", \"macro_GBM\":\"Macro, GBM\",\n","        \"macro+silence_GBM\":\"Macro + silence, GBM\", \"silence_LR\":\"Silence only, logit\"}\n","MCOL = {\"persistence\":GREY, \"macro_LR\":BLUE, \"macro+silence_LR\":ORANGE, \"macro_GBM\":BLUE, \"macro+silence_GBM\":ORANGE, \"silence_LR\":PURPLE}\n","AUC = {(\"STRICT\",\"Held-out countries\"):[.716,.793,.794,.829,.834,.620], (\"STRICT\",\"Rolling-origin\"):[.736,.806,.808,.824,.824,.578],\n","       (\"BROAD\",\"Held-out countries\"):[.642,.692,.713,.712,.765,.596], (\"BROAD\",\"Rolling-origin\"):[.633,.669,.662,.674,.649,.527]}\n","fig, axs = plt.subplots(2, 2, figsize=(7.2, 6.4), sharex=True, gridspec_kw=dict(hspace=0.42, wspace=0.12))\n","for (r_, c_), (key, vals) in zip([(0,0),(0,1),(1,0),(1,1)], AUC.items()):\n","    ax = axs[r_, c_]; y_ = np.arange(len(MOD))[::-1]; ax.axvline(0.5, color=INK, lw=1, ls=\"--\", zorder=1)\n","    for yy, v, m in zip(y_, vals, MOD):\n","        ax.hlines(yy, 0.5, v, color=MCOL[m], lw=2.4, zorder=2); ax.scatter(v, yy, s=64, color=MCOL[m], edgecolor=INK, lw=0.8, zorder=3,\n","                  marker=\"D\" if \"GBM\" in m else \"o\"); ax.text(v + 0.013, yy, f\"{v:.3f}\", va=\"center\", fontsize=9)\n","    ax.set_yticks(y_); ax.set_yticklabels([MLAB[m] for m in MOD] if c_ == 0 else []); ax.set_xlim(0.45, 0.93); ax.grid(axis=\"y\", visible=False)\n","    ax.set_title(f\"{'Strict' if key[0]=='STRICT' else 'Broad'} events | {key[1]}\", loc=\"left\", fontsize=10)\n","    if r_ == 1: ax.set_xlabel(\"AUC (dashed line = chance)\")\n","finish(fig, \"F4_early_warning_benchmark\", \"Early-warning benchmark\",\n","       \"Fig. 4. Out-of-sample AUC for predicting a macro-financial stress event in the next year (circle = logistic, diamond = gradient boosting). Rows: strict and broad event definitions. Columns: ten-fold country-grouped validation and rolling-origin validation. Scalers and imputers are fitted inside each training fold only.\",\n","       \"AUC values are taken from the Step 3 run on the full 131-country panel (seed 42).\")\n","\n","# ===================================== F5  forest of silence gain (values from Step 3 output) =====================================\n","GAIN = [(\"Strict | held-out countries | logit\", .000,-.013,.013), (\"Strict | held-out countries | GBM\", .005,-.006,.016),\n","        (\"Strict | rolling-origin | logit\", .002,-.017,.023), (\"Strict | rolling-origin | GBM\", -.000,-.011,.010),\n","        (\"Broad | held-out countries | logit\", .020,.002,.039), (\"Broad | held-out countries | GBM\", .052,.035,.068),\n","        (\"Broad | rolling-origin | logit\", -.008,-.031,.014), (\"Broad | rolling-origin | GBM\", -.025,-.038,-.010)]\n","fig, ax = plt.subplots(figsize=(7.2, 4.3)); y_ = np.arange(len(GAIN))[::-1]; ax.axvline(0, color=INK, lw=1.4)\n","for yy, (lab, m, lo, hi) in zip(y_, GAIN):\n","    sig = lo > 0 or hi < 0; col = GREEN if lo > 0 else (RED if hi < 0 else GREY)\n","    ax.hlines(yy, lo, hi, color=col, lw=3); ax.scatter(m, yy, s=70, color=col, edgecolor=INK, lw=0.8, zorder=3)\n","    ax.text(0.088, yy, f\"{m:+.3f} [{lo:+.3f}, {hi:+.3f}]\", va=\"center\", fontsize=8.8, family=\"DejaVu Sans\")\n","ax.set_yticks(y_); ax.set_yticklabels([g[0] for g in GAIN]); ax.set_xlim(-0.06, 0.15); ax.set_xticks([-0.04, -0.02, 0, 0.02, 0.04, 0.06])\n","ax.set_xlabel(\"AUC gain from adding silence features (95% country-cluster bootstrap CI)\"); ax.grid(axis=\"y\", visible=False)\n","ax.text(0.5, 1.02, \"green: gain, red: loss, grey: CI includes 0\", transform=ax.transAxes, ha=\"center\", fontsize=9, color=INK)\n","finish(fig, \"F5_silence_gain\", \"Does silence add predictive value?\",\n","       \"Fig. 5. Change in AUC when silence features are added to the macro model. Intervals that include zero indicate no reliable gain. Only one of eight comparisons is significantly positive (broad events, held-out countries) and one is significantly negative (broad events, rolling-origin, GBM), so no consistent early-warning value is found.\",\n","       \"Values are taken from the Step 3 run; bootstrap resamples countries (400 draws).\")\n","\n","# ===================================== helpers for governance figures =====================================\n","def sp_ci(sub, n, B=500):\n","    q = sub[[\"M\", n]].dropna(); r = spearmanr(q.M, q[n])[0]; bs = []\n","    for _ in range(B):\n","        b = q.sample(len(q), replace=True, random_state=int(rng.integers(1e9))); bs.append(spearmanr(b.M, b[n])[0])\n","    lo, hi = np.nanpercentile(bs, [2.5, 97.5]); return r, lo, hi, len(q)\n","RES = {n:(sp_ci(cm, n), sp_ci(cm[~micro], n)) for n in have}\n","NUM[\"spearman\"] = {n:{\"all\":RES[n][0], \"excl_micro\":RES[n][1]} for n in have}\n","\n","# ===================================== F6  silence vs governance scatter =====================================\n","sel = [n for n in [\"GovEff\", \"SPI\"] if n in have]\n","if sel:\n","    fig, axs = plt.subplots(1, len(sel), figsize=(7.2, 4.2), squeeze=False, sharey=True, gridspec_kw=dict(wspace=0.16)); axs = axs[0]\n","    for ax, n in zip(axs, sel):\n","        q = cm[[\"M\", n, \"income\", \"country\"]].dropna()\n","        for g in order:\n","            z = q[q.income == g]\n","            if len(z): ax.scatter(z[n], z.M, s=28, color=INC[g], alpha=0.85, edgecolor=\"white\", lw=0.5, label=INC_NAME[g], zorder=3)\n","        co = np.polyfit(q[n], q.M, 1); xs = np.linspace(q[n].min(), q[n].max(), 50); ax.plot(xs, np.polyval(co, xs), color=INK, lw=1.6, ls=\"--\", zorder=2)\n","        pick = pd.concat([q.sort_values(\"M\", ascending=False).head(5), q.sort_values(n).head(1), q.sort_values(n).tail(1)]).drop_duplicates()\n","        tx = [ax.text(r_[n] if False else getattr(r_, n), r_.M, r_.country, fontsize=8.3, zorder=5) for r_ in pick.itertuples()]\n","        adjust_text(tx, ax=ax, arrowprops=dict(arrowstyle=\"-\", color=GREY, lw=0.6), expand=(1.25, 1.4))\n","        from matplotlib.ticker import MaxNLocator\n","        ax.xaxis.set_major_locator(MaxNLocator(nbins=5, prune=\"upper\" if n == sel[0] else None))\n","        r, lo, hi, k = RES[n][0]; ax.set_xlabel(GNAME[n] + (\" (WGI score)\" if n != \"SPI\" else \" (0-100)\")); ax.set_ylabel(\"Mean share of series missing\" if n == sel[0] else \"\")\n","        ax.set_title(f\"{'(a)' if n == sel[0] else '(b)'} rho = {r:+.2f}  [{lo:+.2f}, {hi:+.2f}]\", loc=\"left\", fontsize=10.2)\n","    hh, ll = axs[0].get_legend_handles_labels(); fig.legend(hh, ll, loc=\"lower center\", ncol=3, frameon=False, fontsize=9.5, bbox_to_anchor=(0.5, -0.13))\n","    finish(fig, \"F6_silence_vs_governance\", \"Silence tracks institutional and statistical capacity\",\n","           \"Fig. 6. Country-level mean silence against (a) government effectiveness and (b) the World Bank Statistical Performance Indicator. Dashed lines are linear fits; rho is the Spearman correlation with a 95% country-bootstrap interval. Colours show income group.\",\n","           \"Silence is the country mean of M over 2000-2024; governance values are country means over the same years.\")\n","\n","# ===================================== F7  robustness forest =====================================\n","def fe_std(n):\n","    d = df.sort_values([\"iso\",\"year\"]).copy(); d[n] = (d[n] - d[n].mean()) / d[n].std(); d[\"l1\"] = d.groupby(\"iso\")[n].shift(1)\n","    q = d.dropna(subset=[\"M_missing\", \"l1\"]).copy(); X = q[[\"l1\", \"M_missing\"]].copy()\n","    for _ in range(15): X = X - X.groupby(q.iso.values).transform(\"mean\"); X = X - X.groupby(q.year.values).transform(\"mean\")\n","    r = sm.OLS(X.M_missing, X[[\"l1\"]]).fit(cov_type=\"cluster\", cov_kwds={\"groups\": q.iso.astype(\"category\").cat.codes})\n","    ci = r.conf_int().loc[\"l1\"].values; return r.params[\"l1\"], ci[0], ci[1], r.pvalues[\"l1\"], len(q)\n","FE = {n:fe_std(n) for n in have}; NUM[\"fe\"] = {n:dict(zip([\"coef\",\"lo\",\"hi\",\"p\",\"n\"], FE[n])) for n in have}\n","fig, axs = plt.subplots(1, 2, figsize=(7.2, 3.9), gridspec_kw=dict(wspace=0.2), sharey=True)\n","y_ = np.arange(len(have))[::-1]; ax = axs[0]; ax.axvline(0, color=INK, lw=1.2)\n","for yy, n in zip(y_, have):\n","    for off, (r, lo, hi, k), col, lab in [(0.16, RES[n][0], BLUE, \"All countries\"), (-0.16, RES[n][1], ORANGE, \"Excluding microstates\")]:\n","        ax.hlines(yy + off, lo, hi, color=col, lw=2.6); ax.scatter(r, yy + off, s=44, color=col, edgecolor=INK, lw=0.7, zorder=3, label=lab if yy == y_[0] else None)\n","ax.set_yticks(y_); ax.set_yticklabels([GNAME[n] for n in have]); ax.set_xlim(-0.8, 0.8); ax.set_xticks([-0.6, -0.3, 0, 0.3, 0.6]); ax.set_xlabel(\"Spearman rho (95% CI)\"); ax.set_title(\"(a) Cross-country\", loc=\"left\", fontsize=10.5)\n","ax.grid(axis=\"y\", visible=False); hh, ll = ax.get_legend_handles_labels(); fig.legend(hh, ll, loc=\"lower center\", ncol=2, frameon=False, fontsize=9.5, bbox_to_anchor=(0.3, -0.12))\n","ax = axs[1]; ax.axvline(0, color=INK, lw=1.2)\n","for yy, n in zip(y_, have):\n","    c, lo, hi, p, k = FE[n]; col = GREEN if p < 0.05 else GREY\n","    ax.hlines(yy, lo, hi, color=col, lw=2.6); ax.scatter(c, yy, s=48, color=col, edgecolor=INK, lw=0.7, zorder=3)\n","ax.set_xlabel(\"Effect on M per 1 SD (95% CI)\"); ax.set_title(\"(b) Country + year fixed effects\", loc=\"left\", fontsize=10.5); ax.grid(axis=\"y\", visible=False)\n","finish(fig, \"F7_robustness\", \"Robustness of the governance link\",\n","       \"Fig. 7. (a) Spearman correlation between mean silence and each governance indicator, with and without the 26 microstates (population below 1.5 million). (b) Within-country effect of last year's governance on this year's silence, with country and year fixed effects and country-clustered standard errors; green marks p < 0.05.\",\n","       \"Lower governance is followed by more missing series; all indicators are standardised before the fixed-effects regression.\")\n","\n","# ===================================== event study data =====================================\n","d = df.sort_values([\"iso\",\"year\"]).copy(); d[\"dM\"] = d.groupby(\"iso\").M_missing.diff()\n","J = d[d.dM >= 0.20][[\"iso\",\"year\",\"income\",\"country_s\"]].sort_values(\"year\").reset_index(drop=True)\n","Mw = d.pivot(index=\"iso\", columns=\"year\", values=\"M_missing\"); KS = list(range(-4, 4)); treated = {k:[] for k in KS}; ctrl = {k:[] for k in KS}; did = {k:[] for k in range(0, 4)}\n","for r in J.itertuples():\n","    pre = Mw.loc[r.iso, r.year-4:r.year-1].mean()\n","    pool = [c for c in Mw.index if c not in set(J.iso) and d[d.iso == c].income.iloc[0] == r.income]\n","    if not pool: continue\n","    cp = Mw.loc[pool, r.year-4:r.year-1].mean(axis=1).sub(pre).abs().sort_values().head(5).index; cpre = Mw.loc[cp, r.year-4:r.year-1].mean(axis=1)\n","    for k in KS:\n","        if (r.year + k) in Mw.columns and not np.isnan(Mw.loc[r.iso, r.year+k]):\n","            treated[k].append(Mw.loc[r.iso, r.year+k]); ctrl[k].append(Mw.loc[cp, r.year+k].mean())\n","            if k >= 0: did[k].append((Mw.loc[r.iso, r.year+k] - pre) - (Mw.loc[cp, r.year+k].sub(cpre).mean()))\n","NUM[\"episodes\"] = [f\"{r.country_s} {r.year}\" for r in J.itertuples()]\n","\n","# ===================================== F8  small multiples =====================================\n","if len(J):\n","    nc = 5; nr = math.ceil(len(J) / nc); fig, axs = plt.subplots(nr, nc, figsize=(7.2, 1.75 * nr + 0.9), sharey=True, sharex=True, squeeze=False)\n","    for ax in axs.ravel(): ax.set_visible(False)\n","    for ax, r in zip(axs.ravel(), J.itertuples()):\n","        ax.set_visible(True); s_ = d[d.iso == r.iso]; ax.plot(s_.year, s_.M_missing, color=RED, lw=1.8)\n","        ax.axvline(r.year, color=INK, ls=\"--\", lw=1.1); ax.axvspan(r.year, 2024.4, color=RED, alpha=0.08, lw=0)\n","        ax.set_title(f\"{r.country_s}\", fontsize=9.6, loc=\"left\", pad=3); ax.text(r.year - 0.6, 0.93, str(r.year), ha=\"right\", va=\"top\", fontsize=8.6, color=INK, transform=ax.get_xaxis_transform())\n","        ax.set_ylim(0, 1.0); ax.set_xlim(2000, 2024.4); ax.set_xticks([2000, 2012, 2024]); ax.tick_params(labelsize=8.5)\n","    fig.supxlabel(\"Year\", fontsize=10.5, y=0.02); fig.supylabel(\"Share of series missing\", fontsize=10.5, x=0.015)\n","    fig.tight_layout(rect=(0.02, 0.03, 1, 1))\n","    finish(fig, \"F8_reporting_collapses\", \"The reporting collapses\",\n","           f\"Fig. 8. Share of annual series missing for each of the {len(J)} country-years in which silence jumped by at least 0.20 in one year (dashed line = collapse year, shaded = after). Most episodes coincide with war, state collapse or severe political crisis.\",\n","           \"Episode definition: year-on-year rise in M of at least 0.20.\")\n","\n","# ===================================== F9  event study vs matched controls =====================================\n","if len(J) and any(len(v) for v in did.values()):\n","    fig, axs = plt.subplots(1, 2, figsize=(7.2, 3.8), gridspec_kw=dict(width_ratios=[1.35, 1], wspace=0.3))\n","    ax = axs[0]\n","    for dct, col, lab in [(treated, RED, \"Collapse countries\"), (ctrl, BLUE, \"Matched controls (5 each)\")]:\n","        ks = [k for k in KS if len(dct[k])]; m = np.array([np.mean(dct[k]) for k in ks])\n","        bs = np.array([[np.mean(rng.choice(dct[k], len(dct[k]), replace=True)) for _ in range(1000)] for k in ks]); lo, hi = np.percentile(bs, [2.5, 97.5], axis=1)\n","        ax.fill_between(ks, lo, hi, color=col, alpha=0.18, lw=0); ax.plot(ks, m, color=col, lw=2.4, marker=\"o\", ms=5, label=lab)\n","    ax.axvline(-0.5, color=INK, ls=\"--\", lw=1.1); ax.set_xlabel(\"Years relative to collapse\"); ax.set_ylabel(\"Mean share of series missing\")\n","    ax.set_title(\"(a) Paths\", loc=\"left\", fontsize=10.5); ax.legend(frameon=False, loc=\"upper left\", fontsize=9)\n","    ax = axs[1]; ks = [k for k in did if len(did[k])]; mm = []; cis = []\n","    for k in ks:\n","        v = np.array(did[k]); bs = [np.mean(rng.choice(v, len(v), replace=True)) for _ in range(2000)]; mm.append(v.mean()); cis.append(np.percentile(bs, [2.5, 97.5]))\n","    cis = np.array(cis); ax.bar([f\"t+{k}\" if k else \"t\" for k in ks], mm, color=RED, alpha=0.85, edgecolor=INK, lw=0.8)\n","    ax.errorbar(range(len(ks)), mm, yerr=[np.array(mm) - cis[:, 0], cis[:, 1] - np.array(mm)], fmt=\"none\", ecolor=INK, capsize=4, lw=1.5)\n","    for i, k in enumerate(ks): ax.text(i, 0.012, f\"n={len(did[k])}\", ha=\"center\", va=\"bottom\", fontsize=8.6, color=\"white\", fontweight=\"bold\")\n","    ax.axhline(0, color=INK, lw=1); ax.set_ylabel(\"Difference-in-differences in M\"); ax.set_title(\"(b) Collapse effect\", loc=\"left\", fontsize=10.5); ax.grid(axis=\"x\", visible=False)\n","    NUM[\"did\"] = {f\"t+{k}\":{\"mean\":float(m_), \"lo\":float(c_[0]), \"hi\":float(c_[1]), \"n\":len(did[k])} for k, m_, c_ in zip(ks, mm, cis)}\n","    finish(fig, \"F9_event_study\", \"Collapse versus matched controls\",\n","           \"Fig. 9. Event study of sudden reporting collapses. (a) Mean share of series missing for collapse countries and for five matched controls each (same income group, closest pre-period silence), with 95% bootstrap bands. (b) Difference-in-differences in silence relative to the four pre-collapse years, with 95% bootstrap intervals over episodes.\",\n","           \"Intervals resample episodes; with 5-10 episodes they should be read as descriptive.\")\n","\n","# ===================================== Word file =====================================\n","def run(p, text, bold=False, italic=False, size=11, color=None):\n","    r = p.add_run(text); r.bold = bold; r.italic = italic; r.font.size = Pt(size); r.font.name = \"Times New Roman\"\n","    if color: r.font.color.rgb = RGBColor(*color)\n","    return r\n","doc = Document(); sec = doc.sections[0]; sec.left_margin = sec.right_margin = Inches(0.9); sec.top_margin = sec.bottom_margin = Inches(0.8)\n","p = doc.add_paragraph(); p.alignment = WD_ALIGN_PARAGRAPH.CENTER; run(p, \"LACUNA\", True, size=26, color=(0, 82, 135))\n","p = doc.add_paragraph(); p.alignment = WD_ALIGN_PARAGRAPH.CENTER; run(p, \"Figure Pack\", False, size=16)\n","p = doc.add_paragraph(); p.alignment = WD_ALIGN_PARAGRAPH.CENTER; run(p, \"Protik Das\", True, size=13)\n","p = doc.add_paragraph(); p.alignment = WD_ALIGN_PARAGRAPH.CENTER; run(p, f\"{NUM['n_countries']} low- and middle-income countries, {NUM['n_country_years']:,} country-years, 2000-2024 | generated {dt.date.today().isoformat()}\", italic=True, size=10)\n","p = doc.add_paragraph(); run(p, \"Contents\", True, size=12)\n","for i, f in enumerate(FIGS, 1): q = doc.add_paragraph(); run(q, f\"Fig. {i}.  {f[1]}\", size=11)\n","doc.add_page_break()\n","for i, (path, title, cap, note) in enumerate(FIGS, 1):\n","    h = doc.add_paragraph(); run(h, f\"Figure {i} | {title}\", True, size=12, color=(0, 82, 135))\n","    pp = doc.add_paragraph(); pp.alignment = WD_ALIGN_PARAGRAPH.CENTER; pp.add_run().add_picture(path, width=Inches(6.4))\n","    c = doc.add_paragraph(); run(c, cap, size=10.5)\n","    if note: n_ = doc.add_paragraph(); run(n_, \"Note: \" + note, italic=True, size=9.5, color=(90, 90, 90))\n","    doc.add_page_break()\n","h = doc.add_paragraph(); run(h, \"Appendix | Numbers behind the figures (for writing the paper)\", True, size=12, color=(0, 82, 135))\n","lines = [f\"Panel: {NUM['n_countries']} countries, {NUM['n_country_years']} country-years; microstates (<1.5M): {NUM['n_microstates']